---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Gallery from '../../components/react/Gallery.tsx';
import { pic } from '../../lib/images';
import { article, breadcrumbs } from '../../lib/seo';

export async function getStaticPaths() {
  const all = (await getCollection('noticias')).sort((a, b) => +b.data.date - +a.data.date);
  return all.map((n, i) => ({ params: { slug: n.id }, props: { n, newer: all[i - 1], older: all[i + 1], all } }));
}

type Props = { n: CollectionEntry<'noticias'>; newer?: CollectionEntry<'noticias'>; older?: CollectionEntry<'noticias'>; all: CollectionEntry<'noticias'>[] };
const { n, newer, older, all } = Astro.props as Props;
const { Content } = await render(n);
const path = `/noticias/${n.id}/`;
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Noticias', path: '/noticias/' },
  { name: n.data.title, path },
];
const fmt = (d: Date) => d.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const ogImage = `/og/noticias/${n.id}.jpg`;

const gallery = await Promise.all(
  n.data.gallery.map(async (g, i) => ({
    thumb: await pic(g, [480, 800, 1200]),
    full: await pic(g, [1200, 1800, 2400]),
    caption: `${n.data.title} · foto ${i + 1}`,
  })),
);
const related = all.filter((x) => x.id !== n.id && x.data.category === n.data.category).slice(0, 3);
const more = related.length ? related : all.filter((x) => x.id !== n.id).slice(0, 3);
---

<Layout
  title={n.data.title}
  description={n.data.excerpt}
  image={ogImage}
  imageAlt={n.data.title}
  ogType="article"
  hasBreadcrumb
  headerOverHero={false}
  schema={[
    breadcrumbs(path, crumbs),
    article({ path, title: n.data.title, description: n.data.excerpt, image: ogImage, date: n.data.date, section: n.data.category }),
  ]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={n.data.date.toISOString()} />
    <meta property="article:section" content={n.data.category} />
  </Fragment>

  <article class="grano">
    <header class="mx-auto max-w-4xl px-5 pt-[calc(var(--header-h)+3rem)] sm:px-8 lg:pt-[calc(var(--header-h)+4.5rem)]">
      <Breadcrumbs crumbs={crumbs.slice(0, 2)} />
      <p class="animate-fade-up mt-8 flex flex-wrap items-center gap-3 text-[0.8rem] font-semibold text-niebla">
        <span class="rounded-full bg-hoja/12 px-3 py-1 text-hoja">{n.data.category}</span>
        <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmt(n.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{n.data.source}</span>
      </p>
      <h1 class="display animate-fade-up mt-6 text-4xl text-balance text-olivo sm:text-5xl lg:text-6xl" style="animation-delay:100ms">{n.data.title}</h1>
    </header>

    <div class="mx-auto mt-12 max-w-6xl px-3 sm:px-8">
      <div class="animate-fade-up overflow-hidden rounded-[2rem] bg-gris" style="animation-delay:200ms">
        <Image src={n.data.cover} alt={n.data.title} widths={[640, 1000, 1400, 2000]} sizes="(min-width:1152px) 1100px, 100vw" class="max-h-[42rem] w-full object-cover" loading="eager" fetchpriority="high" />
      </div>
    </div>

    <div class="prose-gk mx-auto mt-14 max-w-3xl px-5 pb-10 text-[1.125rem] sm:px-8 [&>p:first-child]:font-serif [&>p:first-child]:text-2xl [&>p:first-child]:leading-snug [&>p:first-child]:text-olivo">
      <Content />
    </div>

    {
      gallery.length > 0 && (
        <div class="mx-auto max-w-6xl px-5 pb-16 sm:px-8">
          <p class="eyebrow mb-6 text-hoja">Galería</p>
          <Gallery client:visible items={gallery} layout="grid" />
        </div>
      )
    }

    <!-- Anterior / siguiente -->
    <nav aria-label="Más noticias" class="mx-auto grid max-w-6xl gap-4 px-5 pb-24 sm:grid-cols-2 sm:px-8">
      {
        older ? (
          <a href={`/noticias/${older.id}/`} class="group rounded-[1.5rem] bg-gris/60 p-7 transition-colors hover:bg-gris">
            <span class="eyebrow text-niebla">← Anterior</span>
            <span class="mt-3 block font-serif text-xl leading-snug text-olivo group-hover:text-hoja">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a href={`/noticias/${newer.id}/`} class="group rounded-[1.5rem] bg-gris/60 p-7 text-right transition-colors hover:bg-gris">
            <span class="eyebrow text-niebla">Siguiente →</span>
            <span class="mt-3 block font-serif text-xl leading-snug text-olivo group-hover:text-hoja">{newer.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>

  <section class="bg-gris/60">
    <div class="mx-auto max-w-[90rem] px-5 py-20 sm:px-8 lg:px-12 lg:py-24">
      <div class="flex items-end justify-between gap-6">
        <h2 class="display text-4xl text-olivo">También te puede interesar</h2>
        <a href="/noticias/" class="link-line hidden text-sm font-semibold text-hoja sm:block">Todas las noticias →</a>
      </div>
      <div class="mt-10 grid gap-x-6 gap-y-10 md:grid-cols-3">
        {
          more.map((m) => (
            <a href={`/noticias/${m.id}/`} class="group block">
              <div class="zoom aspect-[4/3] overflow-hidden rounded-2xl bg-gris">
                <Image src={m.data.cover} alt="" widths={[480, 800]} sizes="(min-width:768px) 30vw, 100vw" class="size-full object-cover" />
              </div>
              <p class="mt-4 text-[0.78rem] font-semibold text-niebla">{fmt(m.data.date)}</p>
              <h3 class="mt-2 font-serif text-xl leading-snug text-olivo group-hover:text-hoja">{m.data.title}</h3>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="pt-3 sm:pt-4"><CtaBand /></div>
</Layout>
