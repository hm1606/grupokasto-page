---
import NewsArticleView from '../../views/NewsArticleView.astro';
import { getNews, newsUrl } from '../../lib/news';

export async function getStaticPaths() {
  const all = await getNews('es');
  const others = await getNews('en');
  return all.map((n) => {
    const twin = others.find((o) => o.key === n.key);
    return { params: { slug: n.slug }, props: { n, all, alternate: twin ? newsUrl('en', twin.slug) : undefined } };
  });
}
---

<NewsArticleView lang="es" n={Astro.props.n} all={Astro.props.all} alternate={Astro.props.alternate} />
