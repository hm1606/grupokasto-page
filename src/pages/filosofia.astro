---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { mission, purpose, values, vision, waysOfWorking } from '../data/company';
import { img } from '../lib/images';
import { breadcrumbs } from '../lib/seo';

const path = '/filosofia/';
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Nosotros', path: '/nosotros/' },
  { name: 'Filosofía', path },
];
---

<Layout
  title="Filosofía: propósito, misión, visión y valores"
  description="Propósito, misión, visión, valores y formas de trabajo de Grupo Kasto: compromiso, responsabilidad, honestidad, respeto, humildad y lealtad."
  pageType="AboutPage"
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs)]}
>
  <PageHero eyebrow="Filosofía" title="Nuestra razón de ser." image={img('portada/elote')} crumbs={crumbs} />

  <!-- Propósito -->
  <section class="grano">
    <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-36">
      <div class="lg:col-span-7">
        <p class="eyebrow flex items-center gap-3 text-hoja" data-reveal><span class="h-px w-8 bg-hoja/50"></span>Nuestro propósito</p>
        <p class="display mt-8 text-4xl text-balance text-olivo sm:text-5xl lg:text-[4.2rem]" data-reveal style="--reveal-delay:100ms">
          Contribuir al desarrollo integral de las comunidades de manera sostenible, llevando <em class="text-hoja">felicidad a la mesa</em> de todos los hogares.
        </p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <div class="overflow-hidden rounded-[2rem]" data-reveal="mask">
          <Image src={img('portada/silos-cielo')} alt="Silos bajo el cielo" widths={[400, 700, 1000]} sizes="(min-width:1024px) 30vw, 100vw" class="aspect-[3/4] w-full object-cover" />
        </div>
      </div>
    </div>
    <span class="sr-only">{purpose}</span>
  </section>

  <!-- Misión y visión -->
  <section class="bg-gris/60">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead eyebrow="Rumbo al futuro" title="Misión y visión" />
      <div class="mt-14 grid gap-5 lg:grid-cols-2">
        <article class="relative overflow-hidden rounded-[2rem] bg-olivo p-10 text-crema sm:p-14" data-reveal>
          <p class="eyebrow text-trigo">Misión</p>
          <p class="display mt-6 text-3xl leading-snug sm:text-4xl">{mission}</p>
          <span class="absolute -right-6 -bottom-10 font-serif text-[12rem] leading-none text-white/5" aria-hidden="true">M</span>
        </article>
        <article class="relative overflow-hidden rounded-[2rem] bg-trigo p-10 text-olivo sm:p-14" data-reveal style="--reveal-delay:120ms">
          <p class="eyebrow text-sombra">Visión</p>
          <p class="display mt-6 text-3xl leading-snug sm:text-4xl">{vision}</p>
          <span class="absolute -right-6 -bottom-10 font-serif text-[12rem] leading-none text-olivo/8" aria-hidden="true">V</span>
        </article>
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="bg-crema">
    <div class="mx-auto grid max-w-[90rem] gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-32">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <SectionHead eyebrow="Cultura corporativa" title="Nuestros valores" text="Guían cada decisión, cada negociación y cada relación, dentro y fuera del grupo." />
          <div class="mt-10 hidden overflow-hidden rounded-[2rem] lg:block" data-reveal="mask">
            <Image src={img('portada/espiga')} alt="Espigas de trigo" widths={[400, 800]} sizes="30vw" class="aspect-[4/5] w-full object-cover" />
          </div>
        </div>
      </div>
      <ol class="grid gap-px overflow-hidden rounded-[2rem] bg-olivo/10 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
        {
          values.map((v, i) => (
            <li class="group bg-crema p-8 transition-colors duration-500 hover:bg-white sm:p-10" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
              <span class="font-serif text-sm text-hoja tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display mt-4 text-3xl text-olivo">{v.name}</h3>
              <p class="mt-3 leading-relaxed text-tinta/70">{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Formas de trabajo -->
  <section class="relative overflow-hidden bg-olivo text-crema">
    <div class="absolute inset-0 opacity-25" data-parallax="0.1">
      <Image src={img('portada/molino-noche')} alt="" widths={[800, 1600]} sizes="100vw" class="h-[120%] w-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-olivo via-olivo/85 to-olivo"></div>
    <div class="relative mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead light eyebrow="Cultura corporativa" title="Formas de trabajo" />
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          waysOfWorking.map((w, i) => (
            <article class="rounded-[1.75rem] bg-white/6 p-8 ring-1 ring-white/10 backdrop-blur-sm" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="grid size-11 place-items-center rounded-full bg-trigo font-serif text-olivo">{i + 1}</span>
              <h3 class="display mt-6 text-2xl">{w.name}</h3>
              <p class="mt-3 leading-relaxed text-crema/70">{w.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <div class="pt-3 sm:pt-4"><CtaBand /></div>
</Layout>
