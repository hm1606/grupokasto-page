---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import CtaBand from '../../components/CtaBand.astro';
import Gallery from '../../components/react/Gallery.tsx';
import { divisions, type Division } from '../../data/divisions';
import { services } from '../../data/services';
import { telHref } from '../../data/site';
import { img, pic } from '../../lib/images';
import { breadcrumbs, division as divisionSchema } from '../../lib/seo';

export function getStaticPaths() {
  return divisions.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}

const { d } = Astro.props as { d: Division };
const path = `/divisiones/${d.slug}/`;
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Divisiones', path: '/divisiones/' },
  { name: d.short, path },
];
const idx = divisions.findIndex((x) => x.slug === d.slug);
const prev = divisions[(idx - 1 + divisions.length) % divisions.length];
const next = divisions[(idx + 1) % divisions.length];
const related = services.filter((s) => s.division === d.slug);

const galleryItems = await Promise.all(
  d.gallery.map(async (g) => ({
    thumb: await pic(`divisiones/${d.slug}/${g.image}`, [480, 800, 1200]),
    full: await pic(`divisiones/${d.slug}/${g.image}`, [1200, 1800, 2400]),
    caption: g.caption,
    note: d.short,
  })),
);
const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
---

<Layout
  title={d.seo.title}
  description={d.seo.description}
  image={`/og/divisiones/${d.slug}.jpg`}
  imageAlt={`${d.name} de Grupo Kasto`}
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs), divisionSchema(d)]}
>
  <PageHero eyebrow={d.name} title={d.headline} intro={d.summary} image={img(`divisiones/${d.slug}/hero`)} crumbs={crumbs}>
    <dl class="animate-fade-up mt-12 grid max-w-3xl grid-cols-3 gap-6 border-t border-white/15 pt-6" style="animation-delay:360ms" data-intro-wait>
      {
        d.highlights.map((h) => (
          <div>
            <dt class="sr-only">{h.label}</dt>
            <dd>
              <span class="display block text-2xl text-trigo sm:text-4xl">{h.value}</span>
              <span class="mt-1 block text-xs text-white/70 sm:text-sm">{h.label}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </PageHero>

  <!-- Qué hace -->
  <section class="grano">
    <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-32">
      <div class="lg:col-span-6">
        <SectionHead eyebrow="La división" title={d.name} />
        <div class="prose-gk mt-8" data-reveal style="--reveal-delay:200ms">
          {d.intro.map((p) => <p>{p}</p>)}
        </div>
        <p class="eyebrow mt-10 flex items-center gap-2 text-niebla" data-reveal style="--reveal-delay:260ms">
          <svg viewBox="0 0 24 24" class="size-4 text-hoja" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
          {d.region}
        </p>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <div class="overflow-hidden rounded-[2rem]" data-reveal="mask">
          <Image src={img(`divisiones/${d.slug}/info`)} alt={d.name} widths={[480, 800, 1200]} sizes="(min-width:1024px) 38vw, 100vw" class="aspect-[4/5] w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Unidades de negocio -->
  <section class="relative overflow-hidden bg-olivo text-crema">
    <div class="surcos-claro absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-[90rem] gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-32">
      <div class="lg:col-span-5">
        <SectionHead light eyebrow="¿Quiénes participan en la división?" title="Unidades de negocio" />
        <p class="mt-8 text-lg leading-relaxed text-crema/75" data-reveal style="--reveal-delay:200ms">{d.unitsNote}</p>
      </div>
      <ol class="lg:col-span-6 lg:col-start-7">
        {
          d.units.map((u, i) => (
            <li class="flex items-baseline gap-6 border-b border-white/10 py-6 first:border-t" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="font-serif text-lg text-trigo tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <span class="display text-2xl sm:text-3xl">{u}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Directorio -->
  <section class="bg-gris/60">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead eyebrow="Directorio" title="Dónde encontrarnos" />
      <div class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {
          d.directory.map((e, i) => (
            <article class="flex flex-col rounded-[1.75rem] bg-crema p-8 ring-1 ring-olivo/8" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
              {e.place && <p class="eyebrow text-hoja">{e.place}</p>}
              <h3 class:list={['font-serif text-2xl leading-snug text-olivo', e.place && 'mt-3']}>{e.company}</h3>
              <address class="mt-4 flex-1 leading-relaxed text-tinta/70 not-italic">
                {e.lines.map((l) => (
                  <span class="block">{l}</span>
                ))}
              </address>
              <div class="mt-6 flex flex-wrap gap-2">
                {e.phones.map((p) => (
                  <a href={telHref(p)} class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-olivo ring-1 ring-olivo/10 transition-colors hover:bg-hoja hover:text-white hover:ring-hoja">
                    <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
                    </svg>
                    {p}
                  </a>
                ))}
              </div>
              {(e.web || e.social?.length) && (
                <div class="mt-6 flex flex-wrap items-center gap-2 border-t border-olivo/10 pt-5">
                  {e.web && (
                    <a href={e.web} target="_blank" rel="noopener" class="link-line mr-2 text-sm font-semibold text-hoja">
                      {host(e.web)} ↗
                    </a>
                  )}
                  {e.social?.map((s) => (
                    <SocialIcon {...s} class="size-9 border-olivo/15 text-olivo hover:border-hoja hover:bg-hoja hover:text-white" />
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Instalaciones -->
  <section class="bg-crema">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead eyebrow="Nuestras instalaciones" title="Conócelas" />
      <div class="mt-12" data-reveal>
        <Gallery client:visible items={galleryItems} />
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="bg-crema pb-24 lg:pb-32">
        <div class="mx-auto max-w-[90rem] px-5 sm:px-8 lg:px-12">
          <p class="eyebrow text-niebla">Servicio relacionado</p>
          <div class="mt-5 grid gap-4 md:grid-cols-2">
            {related.map((s) => (
              <a href={`/servicios/${s.slug}/`} class="group flex items-center justify-between gap-6 rounded-[1.75rem] bg-gris/70 p-8 transition-colors hover:bg-gris">
                <span>
                  <span class="display block text-3xl text-olivo">{s.name}</span>
                  <span class="mt-2 block text-tinta/65">{s.summary}</span>
                </span>
                <span class="grid size-12 shrink-0 place-items-center rounded-full bg-olivo text-crema transition-colors group-hover:bg-hoja">
                  <svg viewBox="0 0 16 16" class="arrow size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M3 8h10m-4-4 4 4-4 4" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Otras divisiones -->
  <nav aria-label="Otras divisiones" class="border-t border-olivo/10 bg-crema">
    <div class="mx-auto grid max-w-[90rem] sm:grid-cols-2">
      <a href={`/divisiones/${prev.slug}/`} class="group flex flex-col gap-2 px-5 py-10 transition-colors hover:bg-gris/60 sm:px-8 lg:px-12">
        <span class="eyebrow text-niebla">← División anterior</span>
        <span class="display text-3xl text-olivo transition-colors group-hover:text-hoja">{prev.short}</span>
      </a>
      <a href={`/divisiones/${next.slug}/`} class="group flex flex-col items-end gap-2 border-t border-olivo/10 px-5 py-10 text-right transition-colors hover:bg-gris/60 sm:border-t-0 sm:border-l sm:px-8 lg:px-12">
        <span class="eyebrow text-niebla">Siguiente división →</span>
        <span class="display text-3xl text-olivo transition-colors group-hover:text-hoja">{next.short}</span>
      </a>
    </div>
  </nav>

  <CtaBand title={`¿Te interesa la <em class="text-trigo">${d.short.toLowerCase()}</em>?`} />
</Layout>
