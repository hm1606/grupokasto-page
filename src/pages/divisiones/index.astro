---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { divisions } from '../../data/divisions';
import { img } from '../../lib/images';
import { abs, breadcrumbs } from '../../lib/seo';

const path = '/divisiones/';
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Divisiones', path },
];
const list = {
  '@type': 'ItemList',
  '@id': `${abs(path)}#divisiones`,
  itemListElement: divisions.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.name, url: abs(`/divisiones/${d.slug}/`) })),
};
---

<Layout
  title="Divisiones de negocio"
  description="Granos, molinos de trigo, pecuaria, servicios, invernaderos, panadería y bistró, productos de consumo y promotora de inversión: las ocho divisiones de Grupo Kasto."
  pageType="CollectionPage"
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs), list]}
>
  <PageHero
    eyebrow="Divisiones"
    title="Ocho divisiones, una misma cadena de valor."
    intro="Desde el acopio del grano hasta el anaquel y la mesa: así se complementan los negocios de Grupo Kasto."
    image={img('portada/trigal')}
    crumbs={crumbs}
  />

  <section class="grano">
    <div class="mx-auto max-w-[90rem] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
      <ul class="grid gap-5 md:grid-cols-2">
        {
          divisions.map((d, i) => (
            <li class:list={[(i === 0 || i === divisions.length - 1) && 'md:col-span-2']} data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
              <a href={`/divisiones/${d.slug}/`} class="group relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-[2rem] bg-bosque p-8 text-white sm:p-10 lg:min-h-[30rem]">
                <div class="zoom absolute inset-0 -z-10">
                  <Image
                    src={img(`divisiones/${d.slug}/hero`)}
                    alt=""
                    widths={[640, 1000, 1600]}
                    sizes={i === 0 || i === divisions.length - 1 ? '(min-width:768px) 90vw, 100vw' : '(min-width:768px) 45vw, 100vw'}
                    class="size-full object-cover"
                  />
                </div>
                <div class="absolute inset-0 -z-10 bg-gradient-to-t from-bosque via-bosque/40 to-transparent transition-opacity duration-700 group-hover:opacity-90" />
                <div class="flex items-end justify-between gap-8">
                  <div>
                    <p class="eyebrow text-trigo">
                      {String(i + 1).padStart(2, '0')} · {d.region}
                    </p>
                    <h2 class="display mt-4 text-4xl sm:text-5xl">{d.short}</h2>
                    <p class="mt-3 max-w-xl text-white/80">{d.summary}</p>
                  </div>
                  <span class="grid size-14 shrink-0 place-items-center rounded-full bg-white/15 backdrop-blur transition-colors duration-500 group-hover:bg-trigo group-hover:text-bosque">
                    <svg viewBox="0 0 16 16" class="arrow size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M3 8h10m-4-4 4 4-4 4" />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Layout>
