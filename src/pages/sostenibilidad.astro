---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Pillars from '../components/react/Pillars.tsx';
import { background, context, materiality, pdf, pillars, sdgs, stakeholders } from '../data/sustainability';
import { img, pic } from '../lib/images';
import { breadcrumbs } from '../lib/seo';

const path = '/sostenibilidad/';
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Sostenibilidad', path },
];
const pillarImages = {
  ambiental: await pic('sostenibilidad/ambiental-foto', [480, 800, 1200]),
  social: await pic('sostenibilidad/social-foto', [480, 800, 1200]),
  gobernanza: await pic('sostenibilidad/gobernanza-foto', [480, 800, 1200]),
};
const milestones = [
  { year: '2021', title: 'Un Día para Dar', text: background[0] },
  { year: '2023', title: 'Diagnóstico de Sostenibilidad', text: background[1] },
  { year: '2024', title: 'Rumbo a la Sostenibilidad', text: background[2] },
];
---

<Layout
  title="Sostenibilidad: nuestro modelo ASG"
  description="Modelo de Sostenibilidad de Grupo Kasto: criterios ASG (Ambiental, Social y Gobernanza), ámbitos de acción, objetivos estratégicos y alineación con los ODS de la ONU."
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs)]}
>
  <PageHero
    eyebrow="Sostenibilidad"
    title="Grupo Kasto, rumbo a la sostenibilidad."
    intro="Un plan estratégico que integra los criterios Ambiental, Social y de Gobernanza a nuestra operación cotidiana."
    image={img('portada/contacto')}
    crumbs={crumbs}
  >
    <a href={pdf} class="btn btn-trigo animate-fade-up mt-10" style="animation-delay:360ms" data-intro-wait download>
      Descargar el modelo (PDF)
      <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 2v9m-4-4 4 4 4-4M3 14h10"></path></svg>
    </a>
  </PageHero>

  <!-- Antecedentes -->
  <section class="grano">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead eyebrow="Antecedentes" title="Un camino que empezó <em class='text-hoja'>donando</em>." />
      <ol class="mt-14 grid gap-5 lg:grid-cols-3">
        {
          milestones.map((m, i) => (
            <li class="relative rounded-[1.75rem] bg-white p-8 ring-1 ring-olivo/8 sm:p-10" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <p class="display text-6xl text-hoja">{m.year}</p>
              <h3 class="mt-5 text-lg font-semibold text-olivo">{m.title}</h3>
              <p class="mt-3 leading-relaxed text-tinta/70">{m.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Contexto -->
  <section class="bg-gris/60">
    <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-32">
      <div class="lg:col-span-5">
        <div class="overflow-hidden rounded-[2rem]" data-reveal="mask">
          <Image src={img('sostenibilidad/contexto')} alt="Colaborador en granja porcina" widths={[480, 800]} sizes="(min-width:1024px) 38vw, 100vw" class="aspect-[4/5] w-full object-cover" />
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <SectionHead eyebrow="Contexto" title="La sostenibilidad es la permanencia del negocio." />
        <div class="prose-gk mt-8" data-reveal style="--reveal-delay:160ms">
          {context.map((p) => <p>{p}</p>)}
        </div>
        <blockquote class="mt-10 border-l-2 border-hoja pl-6 font-serif text-2xl leading-snug text-olivo" data-reveal style="--reveal-delay:220ms">
          Este Modelo nos permite focalizar de manera estratégica nuestro tiempo, talento y recursos en las metas de corto, mediano y largo plazo.
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Materialidad -->
  <section class="grano">
    <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-2 lg:gap-20 lg:px-12 lg:py-32">
      <div>
        <SectionHead eyebrow="Grupo Kasto 2024" title="Matriz de materialidad" text={materiality} />
      </div>
      <div class="rounded-[2rem] bg-white p-6 ring-1 ring-olivo/8 sm:p-10" data-reveal>
        <Image src={img('sostenibilidad/matriz-esg-ods')} alt="Matriz de materialidad de Grupo Kasto alineada con los criterios ASG y los ODS" widths={[735]} sizes="(min-width:1024px) 45vw, 100vw" class="w-full" />
      </div>
    </div>
  </section>

  <!-- Dimensiones ASG -->
  <section class="relative overflow-hidden bg-olivo text-crema">
    <div class="surcos-claro absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:items-end">
        <SectionHead
          light
          eyebrow="Nuestro modelo"
          title="Tres dimensiones, un mismo <em class='text-trigo'>compromiso</em>."
          text="Los criterios ASG no son excluyentes: se refuerzan entre sí, a la vez que contemplan la generación de valor económico para nuestra organización."
        />
        <div class="hidden justify-end lg:flex" data-reveal>
          <Image src={img('sostenibilidad/modelo')} alt="Diagrama del modelo: Ambiental, Social y Gobernanza" widths={[473]} sizes="16rem" class="w-64 rounded-full" />
        </div>
      </div>
      <div class="mt-16" data-reveal>
        <Pillars client:visible pillars={pillars} images={pillarImages} />
      </div>
    </div>
  </section>

  <!-- ODS -->
  <section class="grano">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead
        eyebrow="Alineación con la ONU"
        title="Objetivos de Desarrollo Sostenible"
        text="Nuestro Modelo está diseñado para visualizar nuestros esfuerzos y su alineación con los Objetivos de Desarrollo Sostenible de la ONU."
      />
      <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          sdgs.map((s, i) => (
            <li class="group flex flex-col rounded-[1.5rem] bg-white p-5 ring-1 ring-olivo/8 transition-shadow duration-500 hover:shadow-xl hover:shadow-olivo/8" data-reveal style={`--reveal-delay:${(i % 5) * 70}ms`}>
              <Image src={img(`sostenibilidad/ods/${s.image}`)} alt={`ODS ${s.n}: ${s.name}`} widths={[127]} sizes="4rem" class="size-16 rounded-lg" />
              <p class="mt-4 text-sm font-semibold text-olivo">
                ODS {s.n} · {s.name}
              </p>
              <p class="mt-2 text-[0.88rem] leading-relaxed text-tinta/65">{s.goal}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Grupos de interés -->
  <section class="bg-gris/60">
    <div class="mx-auto grid max-w-[90rem] gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-32">
      <div class="lg:col-span-4">
        <SectionHead
          eyebrow="Con quién construimos"
          title="Grupos de interés"
          text="Todas las personas y organizaciones con las que interactuamos día a día. Identificamos sus expectativas y definimos canales de comunicación para beneficio de todas las partes."
        />
        <div class="mt-10 hidden overflow-hidden rounded-full lg:block lg:w-64" data-reveal>
          <Image src={img('sostenibilidad/grupos-de-interes')} alt="Colaboradores de Grupo Kasto" widths={[292]} sizes="16rem" class="w-full" />
        </div>
      </div>
      <ul class="grid gap-px overflow-hidden rounded-[2rem] bg-olivo/10 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
        {
          stakeholders.map((s, i) => (
            <li class="bg-crema p-7 sm:p-8" data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
              <p class="font-serif text-2xl text-olivo">{s.name}</p>
              <p class="mt-2 leading-relaxed text-tinta/70">{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="pt-3 sm:pt-4">
    <CtaBand
      title="Conoce el modelo <em class='text-trigo'>completo</em>."
      text="Descarga el documento del Modelo de Sostenibilidad de Grupo Kasto o escríbenos si quieres colaborar en alguna iniciativa."
      image="portada/trigo-verde"
    />
  </div>
</Layout>
