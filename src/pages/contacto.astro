---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SocialIcon from '../components/SocialIcon.astro';
import ContactForm from '../components/react/ContactForm.tsx';
import { contactTopics, offices, site, telHref } from '../data/site';
import { img } from '../lib/images';
import { breadcrumbs } from '../lib/seo';

const path = '/contacto/';
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Contacto', path },
];
---

<Layout
  title="Contacto"
  description="Escríbenos o llama a Grupo Kasto: oficinas corporativas en Santa Ana Pacueco, Gto., y contacto de las divisiones Granos, Molinos y Pecuaria. Tel. 352 526 1939."
  pageType="ContactPage"
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs)]}
>
  <PageHero
    eyebrow="Contacto"
    title="Hablemos."
    intro="A través de las empresas de nuestras unidades de negocio podemos ofrecerte una variedad de productos y servicios para tus necesidades."
    image={img('portada/espigas-cielo')}
    crumbs={crumbs}
  />

  <section class="grano">
    <div class="mx-auto grid max-w-[90rem] gap-16 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-32">
      <div class="lg:col-span-7">
        <p class="eyebrow flex items-center gap-3 text-hoja"><span class="h-px w-8 bg-hoja/50"></span>Escríbenos</p>
        <h2 class="display mt-5 text-4xl text-olivo sm:text-5xl">Cuéntanos en qué te podemos ayudar.</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-tinta/70">
          Tu mensaje llega a nuestro equipo de comunicación y lo turnamos a la división indicada. También recibimos aquí tus quejas y sugerencias.
        </p>
        <div class="mt-10">
          <ContactForm client:load topics={contactTopics} privacyVersion={site.privacyVersion} email={site.email} />
        </div>
      </div>

      <aside class="lg:col-span-4 lg:col-start-9">
        <div class="space-y-4 lg:sticky lg:top-32">
          <div class="rounded-[1.75rem] bg-olivo p-8 text-crema">
            <p class="eyebrow text-trigo">Directo</p>
            <a href={site.phoneHref} class="display mt-4 block text-3xl hover:text-trigo">{site.phone}</a>
            <a href={`mailto:${site.email}`} class="link-line mt-2 inline-block text-crema/80 hover:text-white">{site.email}</a>
            <div class="mt-6 flex gap-2">
              <SocialIcon network="linkedin" url={site.social.linkedin} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-olivo" />
              <SocialIcon network="facebook" url={site.social.facebook} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-olivo" />
              <SocialIcon network="instagram" url={site.social.instagram} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-olivo" />
            </div>
          </div>
          <p class="px-2 text-sm leading-relaxed text-niebla">
            ¿Buscas empleo? Elige “Bolsa de trabajo” en el formulario. Para temas de datos personales escribe a
            <a href={`mailto:${site.privacyEmail}`} class="font-semibold text-hoja">{site.privacyEmail}</a>.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Oficinas -->
  <section class="bg-gris/60">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-28">
      <p class="eyebrow flex items-center gap-3 text-hoja" data-reveal><span class="h-px w-8 bg-hoja/50"></span>Oficinas</p>
      <h2 class="display mt-5 text-4xl text-olivo sm:text-5xl" data-reveal>Dónde estamos</h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          offices.map((o, i) => (
            <article class="flex flex-col rounded-[1.75rem] bg-crema p-8 ring-1 ring-olivo/8" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <p class="eyebrow text-hoja">{o.name}</p>
              <h3 class="mt-3 font-serif text-xl leading-snug text-olivo">{o.company}</h3>
              <address class="mt-4 flex-1 leading-relaxed text-tinta/70 not-italic">
                {o.lines.map((l) => (
                  <span class="block">{l}</span>
                ))}
              </address>
              <div class="mt-6 space-y-1.5 border-t border-olivo/10 pt-5 text-[0.92rem]">
                <a href={telHref(o.phone)} class="block font-semibold text-olivo hover:text-hoja">{o.phone}</a>
                <a href={`mailto:${o.email}`} class="block text-tinta/70 hover:text-hoja">{o.email}</a>
                <a
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${o.company} ${o.lines.join(' ')}`)}`}
                  target="_blank"
                  rel="noopener"
                  class="link-line inline-block pt-2 text-sm font-semibold text-hoja"
                >
                  Cómo llegar ↗
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <p class="mt-10 text-tinta/70" data-reveal>
        ¿Buscas otra empresa del grupo? Consulta el directorio completo en cada <a href="/divisiones/" class="font-semibold text-hoja underline decoration-hoja/40 underline-offset-4">división</a>.
      </p>
    </div>
  </section>
</Layout>
