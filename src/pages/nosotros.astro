---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Timeline from '../components/react/Timeline.tsx';
import { clientVoices, history, leadership, teamVoices } from '../data/company';
import { site } from '../data/site';
import { img } from '../lib/images';
import { breadcrumbs } from '../lib/seo';

const path = '/nosotros/';
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Nosotros', path },
];
const years = new Date().getFullYear() - site.foundingYear;
---

<Layout
  title="Nosotros: nuestra historia desde 1945"
  description={`Grupo Kasto nace en 1945 en La Piedad, Michoacán. Más de ${years} años en granos, porcicultura, harinas, productos de consumo, invernaderos y panadería.`}
  pageType="AboutPage"
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs)]}
>
  <PageHero
    eyebrow="Nosotros"
    title="Somos su mejor opción desde 1945."
    intro="Un sólido y reconocido grupo de empresas agroindustriales con un gran compromiso social: producción, comercialización, servicios y distribución de productos de consumo."
    image={img('portada/pacas')}
    crumbs={crumbs}
  />

  <!-- Años de experiencia -->
  <section class="grano">
    <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-32">
      <div class="grid grid-cols-2 gap-4 lg:col-span-6">
        <div class="overflow-hidden rounded-[1.75rem]" data-reveal="mask">
          <Image src={img('portada/granos')} alt="Granos de trigo" widths={[400, 800]} sizes="(min-width:1024px) 22vw, 45vw" class="aspect-[4/5] w-full object-cover" />
        </div>
        <div class="mt-16 overflow-hidden rounded-[1.75rem]" data-reveal="mask" style="--reveal-delay:200ms">
          <Image src={img('portada/costal')} alt="Costal con el logotipo de Grupo Kasto" widths={[400, 800]} sizes="(min-width:1024px) 22vw, 45vw" class="aspect-[4/5] w-full object-cover" />
        </div>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <p class="display text-[7rem] leading-none text-hoja sm:text-[9rem]" data-reveal>+{years}</p>
        <p class="eyebrow mt-2 text-hoja" data-reveal style="--reveal-delay:80ms">años de experiencia</p>
        <p class="mt-8 font-serif text-2xl leading-snug text-olivo sm:text-3xl" data-reveal style="--reveal-delay:160ms">{leadership}</p>
      </div>
    </div>
  </section>

  <!-- Historia -->
  <section class="bg-gris/60">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead eyebrow="Conócenos" title="Nuestra historia" text="Grupo Kasto nace en 1945 en La Piedad, Michoacán, en el segmento de la comercialización de semillas. Recorre los hitos que nos trajeron hasta aquí." />
      <div class="mt-14" data-reveal style="--reveal-delay:200ms">
        <Timeline client:visible items={history} />
      </div>
    </div>
  </section>

  <!-- Colaboradores -->
  <section class="bg-crema">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead align="center" eyebrow="El mayor activo de la compañía" title="Nuestros colaboradores" />
      <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          teamVoices.map((t, i) => (
            <figure class="group flex flex-col overflow-hidden rounded-[1.75rem] bg-white ring-1 ring-olivo/8" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <div class="zoom aspect-square overflow-hidden bg-gris">
                <Image src={img(`personas/${t.image}`)} alt={t.name} widths={[320, 640]} sizes="(min-width:1024px) 22vw, (min-width:640px) 45vw, 90vw" class="size-full object-cover" />
              </div>
              <div class="flex flex-1 flex-col p-7">
                <blockquote class="flex-1 font-serif text-xl leading-snug text-olivo">“{t.quote}”</blockquote>
                <figcaption class="mt-6 flex items-baseline justify-between border-t border-olivo/10 pt-4">
                  <span class="font-semibold text-olivo">{t.name}</span>
                  <span class="text-sm text-niebla">Desde {t.since}</span>
                </figcaption>
              </div>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Clientes -->
  <section class="relative overflow-hidden bg-olivo text-crema">
    <div class="surcos-claro absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead light eyebrow="La razón de ser del grupo" title="Nuestros clientes" />
      <div class="mt-16 grid gap-5 lg:grid-cols-3">
        {
          clientVoices.map((c, i) => (
            <figure class="flex flex-col justify-between rounded-[1.75rem] bg-white/6 p-8 ring-1 ring-white/10 sm:p-10" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <svg viewBox="0 0 32 24" class="h-6 w-8 text-trigo" fill="currentColor" aria-hidden="true">
                <path d="M0 24V14C0 6 4 1 12 0l1 4c-4 1-6 4-6 8h5v12H0Zm19 0V14c0-8 4-13 12-14l1 4c-4 1-6 4-6 8h5v12H19Z" />
              </svg>
              <blockquote class="mt-6 font-serif text-xl leading-relaxed">{c.quote}</blockquote>
              <figcaption class="mt-8 flex items-center gap-4 border-t border-white/10 pt-6">
                <Image src={img(`personas/${c.image}`)} alt="" widths={[96, 192]} sizes="48px" class="size-12 rounded-full object-cover" />
                <span>
                  <span class="block font-semibold">{c.name}</span>
                  <span class="text-sm text-crema/60">{c.role}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <div class="mt-14 flex flex-wrap gap-3" data-reveal>
        <a href="/filosofia/" class="btn btn-trigo">Nuestra filosofía</a>
        <a href="/divisiones/" class="btn btn-outline-light">Conoce las divisiones</a>
      </div>
    </div>
  </section>

  <div class="pt-3 sm:pt-4"><CtaBand /></div>
</Layout>
