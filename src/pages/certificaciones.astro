---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { certifications, greenhouseCertifications } from '../data/company';
import { img } from '../lib/images';
import { breadcrumbs } from '../lib/seo';

const path = '/certificaciones/';
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Nosotros', path: '/nosotros/' },
  { name: 'Certificaciones', path },
];
---

<Layout
  title="Certificaciones de calidad e inocuidad"
  description="ISO 9001:2015 y HACCP en granos y molinos desde 2012; FSSC 22000 y Kosher en Molino La Concepción desde 2022; distintivo ESR y certificados de exportación en invernaderos."
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs)]}
>
  <PageHero
    eyebrow="Certificaciones"
    title="Comprometidos con la calidad."
    intro="Cumplimos los más altos estándares de calidad e inocuidad con procesos que nos permiten trabajar de manera eficiente, oportuna y dinámica, con personal altamente capacitado."
    image={img('portada/certificaciones')}
    crumbs={crumbs}
  />

  <section class="grano">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SectionHead
            eyebrow="Nuestros certificados"
            title="Calidad que se <em class='text-hoja'>audita</em>."
            text="Desde 2012, las empresas de las divisiones Granos y Molinos de trigo están certificadas bajo ISO 9001:2015 y HACCP. Desde 2022, Molino La Concepción cuenta además con FSSC 22000 y Kosher."
          />
          <div class="mt-10 overflow-hidden rounded-[2rem]" data-reveal="mask">
            <Image src={img('portada/molino-trigo')} alt="Molino de trigo" widths={[480, 900]} sizes="(min-width:1024px) 38vw, 100vw" class="aspect-[4/3] w-full object-cover" />
          </div>
        </div>
        <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
          {
            certifications.map((c, i) => (
              <li class="flex flex-col rounded-[1.75rem] bg-white p-8 ring-1 ring-olivo/8" data-reveal style={`--reveal-delay:${i * 90}ms`}>
                <div class="grid h-28 place-items-center rounded-2xl bg-crema">
                  <Image src={img(`certificaciones/${c.image}`)} alt={`Logotipo ${c.name}`} widths={[160, 320]} sizes="140px" class="max-h-20 w-auto object-contain" />
                </div>
                <h3 class="display mt-7 text-3xl text-olivo">{c.name}</h3>
                <p class="mt-2 leading-relaxed text-tinta/70">{c.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-olivo text-crema">
    <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-2 lg:gap-24 lg:px-12 lg:py-32">
      <div>
        <SectionHead
          light
          eyebrow="De la mano de nuestra comunidad"
          title="Empresa socialmente responsable"
          text="En la División Invernaderos, además del distintivo ESR, aseguramos la exportación de nuestros productos con los siguientes certificados:"
        />
        <ul class="mt-10 divide-y divide-white/10 border-y border-white/10">
          {
            greenhouseCertifications.map((c, i) => (
              <li class="flex items-center gap-5 py-4" data-reveal style={`--reveal-delay:${i * 60}ms`}>
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-trigo text-olivo">
                  <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg>
                </span>
                <span class="text-lg">{c}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="overflow-hidden rounded-[2rem]" data-reveal="mask">
        <Image src={img('portada/invernadero-madera')} alt="Productos de invernadero" widths={[640, 1000, 1400]} sizes="(min-width:1024px) 45vw, 100vw" class="aspect-[4/5] w-full object-cover" />
      </div>
    </div>
  </section>

  <div class="pt-3 sm:pt-4"><CtaBand /></div>
</Layout>
