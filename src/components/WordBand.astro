---
// Franja de palabras gigantes que se desliza de lado al ritmo del scroll (dos renglones en sentidos opuestos).
// El movimiento lo da data-scroll-x (script del Layout); sin JS o con "reducir movimiento" queda quieta.
type Props = { words: string[]; alt?: string[]; tone?: 'crema' | 'olivo'; label?: string };
const { words, alt = words, tone = 'crema', label } = Astro.props;
const row = (list: string[]) => [...list, ...list, ...list];
---

<section class:list={['word-band relative overflow-hidden py-10 sm:py-14', tone === 'olivo' ? 'bg-sombra text-crema' : 'bg-crema text-olivo']} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <div class="flex w-max items-center gap-10 whitespace-nowrap" data-scroll-x="-0.35">
    {
      row(words).map((w) => (
        <>
          <span class="display text-[17vw] leading-[0.9] uppercase lg:text-[11vw]">{w}</span>
          <svg viewBox="0 0 40 40" class="size-[5vw] shrink-0 text-trigo lg:size-[3.4vw]" aria-hidden="true">
            <path fill="currentColor" d="M20 0c1.6 9.4 4.9 15.9 20 20-15.1 4.1-18.4 10.6-20 20-1.6-9.4-4.9-15.9-20-20C15.1 15.9 18.4 9.4 20 0Z" />
          </svg>
        </>
      ))
    }
  </div>
  <div class="mt-2 flex w-max -translate-x-1/3 items-center gap-10 whitespace-nowrap" data-scroll-x="0.3">
    {
      row(alt).map((w) => (
        <>
          <span class="word-outline display text-[17vw] leading-[0.9] uppercase lg:text-[11vw]">{w}</span>
          <svg viewBox="0 0 40 40" class="size-[5vw] shrink-0 text-hoja lg:size-[3.4vw]" aria-hidden="true">
            <path fill="currentColor" d="M20 0c1.6 9.4 4.9 15.9 20 20-15.1 4.1-18.4 10.6-20 20-1.6-9.4-4.9-15.9-20-20C15.1 15.9 18.4 9.4 20 0Z" />
          </svg>
        </>
      ))
    }
  </div>
</section>

<style>
  .word-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px currentColor;
    opacity: 0.55;
  }
  .word-band :global(.word-outline) {
    -webkit-text-stroke-color: var(--color-hoja);
  }
</style>
