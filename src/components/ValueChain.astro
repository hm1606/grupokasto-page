---
// "Del campo a la mesa": la cadena de valor integrada del grupo, eslabón por eslabón, con la división que lo opera.
import SectionHead from './SectionHead.astro';
import { divisionById, divisionUrl } from '../data/divisions';
import { serviceById, serviceUrl } from '../data/services';
import type { Lang, T } from '../i18n/ui';

type Props = { lang: Lang };
const { lang } = Astro.props;
const d = (id: string) => divisionUrl(lang, divisionById(id)!);

const steps: { title: T; text: T; href: string; unit: T; icon: string }[] = [
  {
    title: { es: 'Siembra y originación', en: 'Planting and sourcing' },
    text: { es: 'Acompañamos al productor desde la siembra, con insumos, financiamiento y compra de su cosecha.', en: 'We support growers from planting, with inputs, financing and the purchase of their harvest.' },
    href: serviceUrl(lang, serviceById('logistica-y-originacion')!),
    unit: { es: 'Logística y originación', en: 'Logistics and sourcing' },
    icon: '<path d="M12 21V11"/><path d="M12 11c0-3.5 2.5-6 6.5-6 0 4-2.5 6.5-6.5 6Z"/><path d="M12 14c0-3-2.2-5-5.5-5 0 3.4 2.2 5.4 5.5 5Z"/><path d="M4 21h16"/>',
  },
  {
    title: { es: 'Acopio y almacenamiento', en: 'Storage' },
    text: { es: 'Recepción en camión y ferrocarril, acondicionamiento y conservación del grano.', en: 'Receiving by truck and rail, conditioning and grain conservation.' },
    href: d('granos'),
    unit: { es: 'División Granos', en: 'Grain Division' },
    icon: '<path d="M5 21V9l3-3 3 3v12"/><path d="M13 21V7l3-3 3 3v14"/><path d="M3 21h18"/><path d="M5 13h6M13 12h6"/>',
  },
  {
    title: { es: 'Molienda', en: 'Milling' },
    text: { es: 'Harinas y subproductos de trigo para la panificación, la tortilla y la industria.', en: 'Wheat flour and by-products for bakeries, tortillas and industry.' },
    href: d('molinos-de-trigo'),
    unit: { es: 'Molinos de trigo', en: 'Flour mills' },
    icon: '<circle cx="12" cy="12" r="3"/><path d="M12 3v6M12 15v6M3 12h6M15 12h6M5.6 5.6l4.3 4.3M14.1 14.1l4.3 4.3M18.4 5.6l-4.3 4.3M9.9 14.1l-4.3 4.3"/>',
  },
  {
    title: { es: 'Producción', en: 'Production' },
    text: { es: 'Porcicultura, alimento balanceado y hortalizas de invernadero para exportación.', en: 'Hog farming, animal feed and greenhouse vegetables for export.' },
    href: d('pecuaria'),
    unit: { es: 'Pecuaria · Invernaderos', en: 'Livestock · Greenhouses' },
    icon: '<path d="M3 20h18"/><path d="M4 20V10l8-6 8 6v10"/><path d="M9 20v-6h6v6"/>',
  },
  {
    title: { es: 'Panadería', en: 'Bakery' },
    text: { es: 'Pan artesanal francés en 11 sucursales de Guadalajara con Ohlala!', en: 'French artisan bread at 11 Ohlala! locations in Guadalajara.' },
    href: d('panaderia-y-bistro'),
    unit: { es: 'Panadería y bistró', en: 'Bakery and bistro' },
    icon: '<path d="M4 15c0-5 3.6-9 8-9s8 4 8 9v3H4v-3Z"/><path d="M9 9.5 10.5 14M15 9.5 13.5 14M12 8v6"/>',
  },
  {
    title: { es: 'Hasta tu mesa', en: 'To your table' },
    text: { es: 'Distribución de productos de consumo con cobertura del 90 % del país.', en: 'Consumer goods distribution covering 90% of Mexico.' },
    href: d('productos-de-consumo'),
    unit: { es: 'Productos de consumo', en: 'Consumer goods' },
    icon: '<path d="M3 7h12v9H3z"/><path d="M15 10h3.5l2.5 3v3h-6"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/>',
  },
];
---

<section class="relative overflow-hidden bg-olivo text-crema">
  <div class="surcos-claro absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHead
        light
        eyebrow={lang === 'es' ? 'Cadena de valor integrada' : 'Integrated value chain'}
        title={lang === 'es' ? "Del campo <span class='text-trigo'>a la mesa</span>" : "From the field <span class='text-trigo'>to the table</span>"}
      />
      <p class="max-w-md text-lg leading-relaxed text-crema/70" data-reveal style="--reveal-delay:200ms">
        {
          lang === 'es'
            ? 'Pocas empresas en México recorren la cadena completa. Nuestras divisiones se complementan para dar certeza en cada eslabón.'
            : 'Few companies in Mexico cover the entire chain. Our divisions complement each other to deliver certainty at every link.'
        }
      </p>
    </div>

    <ol class="chain relative mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-6 lg:gap-0" data-progress>
      <!-- Línea que se dibuja con el scroll uniendo los eslabones (escritorio), con un grano que la recorre -->
      <span class="absolute top-[2.25rem] right-[8%] left-[8%] hidden h-px bg-trigo/15 lg:block" aria-hidden="true"></span>
      <span class="chain-line absolute top-[2.25rem] right-[8%] left-[8%] hidden h-[2px] origin-left bg-gradient-to-r from-trigo/40 to-trigo lg:block" aria-hidden="true"></span>
      <span class="chain-dot absolute top-[2.25rem] hidden size-3 -translate-1/2 rounded-full bg-trigo lg:block" aria-hidden="true"></span>
      {
        steps.map((s, i) => (
          <li class="chain-step relative lg:px-4" style={`--i:${i}`}>
            <a href={s.href} class="group flex h-full flex-col rounded-2xl bg-white/5 p-6 ring-1 ring-white/10 transition-colors duration-500 hover:bg-white/10 lg:items-center lg:bg-transparent lg:p-0 lg:text-center lg:ring-0 lg:hover:bg-transparent">
              <span class="chain-icon relative z-10 grid size-[4.5rem] shrink-0 place-items-center rounded-full border border-trigo/50 bg-olivo text-trigo transition-colors duration-500 group-hover:bg-trigo group-hover:text-olivo">
                <span class="chain-glow absolute inset-0 -z-10 rounded-full bg-trigo/20" aria-hidden="true"></span>
                <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
              </span>
              <span class="chain-text contents">
                <span class="mt-5 font-serif text-sm font-semibold tracking-[0.18em] text-brote uppercase">{String(i + 1).padStart(2, '0')}</span>
                <span class="display mt-1 text-[1.7rem] leading-tight">{s.title[lang]}</span>
                <span class="mt-3 text-[0.95rem] leading-relaxed text-crema/65">{s.text[lang]}</span>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-trigo lg:mt-auto lg:pt-5">
                  {s.unit[lang]}
                  <svg viewBox="0 0 16 16" class="arrow size-3" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" /></svg>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style is:global>
  /* El avance del scroll (--p, del Layout) dibuja la línea; cada eslabón se enciende cuando la línea lo alcanza */
  .chain {
    --p: 0;
    --lp: clamp(0, (var(--p) - 0.18) / 0.5, 1);
  }
  .chain .chain-line {
    transform: translateY(-50%) scaleX(var(--lp));
  }
  .chain .chain-dot {
    left: calc(8% + 84% * var(--lp));
    box-shadow: 0 0 0 6px rgb(237 221 94 / 0.18), 0 0 24px 4px rgb(237 221 94 / 0.45);
    opacity: min(1, calc(var(--lp) * 20));
  }
  .chain .chain-step {
    --on: clamp(0, (var(--lp) - var(--i) / 5) * 7 + 1, 1);
  }
  .chain .chain-step > a {
    opacity: calc(0.28 + var(--on) * 0.72);
    transform: translateY(calc((1 - var(--on)) * 18px));
  }
  .chain .chain-icon {
    scale: calc(0.86 + var(--on) * 0.14);
  }
  .chain .chain-glow {
    opacity: var(--on);
    scale: calc(1 + var(--on) * 0.45);
  }
  @media (max-width: 1023px) {
    /* En celular los eslabones van en columna: se encienden según su propia posición */
    .chain .chain-step {
      --on: 1;
    }
  }
</style>