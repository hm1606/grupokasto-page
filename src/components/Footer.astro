---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';
import { img } from '../lib/images';
import { nav, site } from '../data/site';
import { divisions, divisionUrl } from '../data/divisions';
import { services, serviceUrl } from '../data/services';
import { routes, t, type Lang } from '../i18n/ui';

type Props = { lang: Lang };
const { lang } = Astro.props;
const tx = t(lang);
const year = new Date().getFullYear();
const about = nav(lang).find((n) => n.key === 'about')?.children ?? [];
const company = [
  ...about,
  { label: lang === 'es' ? 'Sostenibilidad' : 'Sustainability', href: routes.sustainability[lang] },
  { label: lang === 'es' ? 'Noticias' : 'News', href: routes.news[lang] },
  { label: lang === 'es' ? 'Contacto' : 'Contact', href: routes.contact[lang] },
];
---

<footer class="relative overflow-hidden bg-olivo text-crema">
  <!-- Firma del sitio anterior: trigo en silueta y la granja dibujada a línea -->
  <Image src={img('marca/trigo-silueta')} alt="" widths={[1920]} sizes="100vw" class="pointer-events-none absolute inset-x-0 top-0 h-28 w-full object-cover object-top opacity-[0.07] select-none" aria-hidden="true" />
  <Image src={img('marca/granja')} alt="" widths={[760]} sizes="38rem" class="pointer-events-none absolute right-0 bottom-0 hidden w-[38rem] opacity-[0.07] select-none lg:block" aria-hidden="true" />

  <div class="relative mx-auto max-w-[90rem] px-5 pt-20 pb-10 sm:px-8 lg:px-12 lg:pt-28">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href={routes.home[lang]} class="inline-flex text-crema" aria-label={`Grupo Kasto, ${tx.home.toLowerCase()}`}>
          <Logo class="text-[1.6rem]" />
        </a>
        <p class="mt-8 max-w-sm text-lg leading-relaxed text-crema/75">{tx.footerAbout}</p>
        <div class="mt-8 flex gap-2">
          <SocialIcon network="linkedin" url={site.social.linkedin} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-olivo" />
          <SocialIcon network="facebook" url={site.social.facebook} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-olivo" />
          <SocialIcon network="instagram" url={site.social.instagram} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-olivo" />
        </div>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-8">
        <div>
          <p class="eyebrow text-brote">{tx.footerDivisions}</p>
          <ul class="mt-5 space-y-2.5 text-[0.95rem] text-crema/75">
            {
              divisions.map((d) => (
                <li>
                  <a href={divisionUrl(lang, d)} class="link-line hover:text-white">
                    {d.short[lang]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="eyebrow text-brote">{tx.footerCompany}</p>
          <ul class="mt-5 space-y-2.5 text-[0.95rem] text-crema/75">
            {
              company.map((c) => (
                <li>
                  <a href={c.href} class="link-line hover:text-white">
                    {c.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="eyebrow mt-9 text-brote">{tx.footerServices}</p>
          <ul class="mt-5 space-y-2.5 text-[0.95rem] text-crema/75">
            {
              services.map((s) => (
                <li>
                  <a href={serviceUrl(lang, s)} class="link-line hover:text-white">
                    {s.name[lang]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="eyebrow text-brote">{tx.footerOffices}</p>
          <address class="mt-5 text-[0.95rem] leading-relaxed text-crema/75 not-italic">
            {site.address.street}<br />
            {site.address.city}, {site.address.stateShort}<br />
            C.P. {site.address.zip}
          </address>
          <ul class="mt-5 space-y-2.5 text-[0.95rem]">
            <li><a href={`mailto:${site.email}`} class="link-line text-crema hover:text-trigo">{site.email}</a></li>
            <li><a href={site.phoneHref} class="link-line text-crema hover:text-trigo">{site.phone}</a></li>
          </ul>
          <a href={routes.contact[lang]} class="btn btn-trigo mt-8 min-h-11 px-5 text-[0.85rem]">{tx.writeUs}</a>
        </div>
      </div>
    </div>

    <div class="mt-20 flex flex-col gap-4 border-t border-white/10 pt-8 text-[0.82rem] text-crema/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Grupo Kasto. {tx.rights}</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href={routes.privacy[lang]} class="link-line hover:text-crema">{tx.privacyNotices}</a>
        <a href={`${routes.contact[lang]}?tema=quejas`} class="link-line hover:text-crema">{tx.complaints}</a>
        <a href="/sitemap-index.xml" class="link-line hover:text-crema">{tx.sitemap}</a>
      </div>
    </div>
  </div>
</footer>
