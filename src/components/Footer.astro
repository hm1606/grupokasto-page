---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';
import { img } from '../lib/images';
import { nav, site } from '../data/site';
import { divisions, divisionUrl } from '../data/divisions';
import { services, serviceUrl } from '../data/services';
import { routes, t, type Lang } from '../i18n/ui';

type Props = { lang: Lang };
const { lang } = Astro.props;
const tx = t(lang);
const year = new Date().getFullYear();
const about = nav(lang).find((n) => n.key === 'about')?.children ?? [];
const company = [
  ...about,
  { label: lang === 'es' ? 'Sostenibilidad' : 'Sustainability', href: routes.sustainability[lang] },
  { label: lang === 'es' ? 'Noticias' : 'News', href: routes.news[lang] },
  { label: lang === 'es' ? 'Contacto' : 'Contact', href: routes.contact[lang] },
];
---

<footer class="relative overflow-hidden bg-olivo text-crema">
  <!-- Al fondo: la granja grabada del sitio anterior, con su sol al atardecer -->
  <div class="farm pointer-events-none absolute select-none" aria-hidden="true" data-parallax="0.06">
    <span class="farm-sun"></span>
    <Image src={img('marca/granja')} alt="" widths={[760]} sizes="(min-width:1024px) 52vw, 96vw" class="farm-img block h-auto w-full" />
  </div>

  <div class="relative mx-auto max-w-[90rem] px-5 pt-20 pb-10 sm:px-8 lg:px-12 lg:pt-28">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href={routes.home[lang]} class="inline-flex text-crema" aria-label={`Grupo Kasto, ${tx.home.toLowerCase()}`}>
          <Logo class="text-[1.6rem]" />
        </a>
        <p class="mt-8 max-w-sm text-lg leading-relaxed text-crema/75">{tx.footerAbout}</p>
        <div class="mt-8 flex gap-2">
          <SocialIcon network="linkedin" url={site.social.linkedin} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-olivo" />
          <SocialIcon network="facebook" url={site.social.facebook} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-olivo" />
          <SocialIcon network="instagram" url={site.social.instagram} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-olivo" />
        </div>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-8">
        <div>
          <p class="eyebrow text-brote">{tx.footerDivisions}</p>
          <ul class="mt-5 space-y-2.5 text-[0.95rem] text-crema/75">
            {
              divisions.map((d) => (
                <li>
                  <a href={divisionUrl(lang, d)} class="link-line hover:text-white">
                    {d.short[lang]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="eyebrow text-brote">{tx.footerCompany}</p>
          <ul class="mt-5 space-y-2.5 text-[0.95rem] text-crema/75">
            {
              company.map((c) => (
                <li>
                  <a href={c.href} class="link-line hover:text-white">
                    {c.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="eyebrow mt-9 text-brote">{tx.footerServices}</p>
          <ul class="mt-5 space-y-2.5 text-[0.95rem] text-crema/75">
            {
              services.map((s) => (
                <li>
                  <a href={serviceUrl(lang, s)} class="link-line hover:text-white">
                    {s.name[lang]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="eyebrow text-brote">{tx.footerOffices}</p>
          <address class="mt-5 text-[0.95rem] leading-relaxed text-crema/75 not-italic">
            {site.address.street}<br />
            {site.address.city}, {site.address.stateShort}<br />
            C.P. {site.address.zip}
          </address>
          <ul class="mt-5 space-y-2.5 text-[0.95rem]">
            <li><a href={`mailto:${site.email}`} class="link-line text-crema hover:text-trigo">{site.email}</a></li>
            <li><a href={site.phoneHref} class="link-line text-crema hover:text-trigo">{site.phone}</a></li>
          </ul>
          <a href={routes.contact[lang]} class="btn btn-trigo mt-8 min-h-11 px-5 text-[0.85rem]">{tx.writeUs}</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom mt-20 flex flex-col gap-4 border-t border-white/10 pt-8 text-[0.82rem] text-crema/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Grupo Kasto. {tx.rights}</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href={routes.privacy[lang]} class="link-line hover:text-crema">{tx.privacyNotices}</a>
        <a href={`${routes.contact[lang]}?tema=quejas`} class="link-line hover:text-crema">{tx.complaints}</a>
        <a href="/sitemap-index.xml" class="link-line hover:text-crema">{tx.sitemap}</a>
      </div>
    </div>
  </div>

  <!-- Al frente: el nombre, enorme -->
  <div class="footer-field relative overflow-hidden" aria-hidden="true" data-field>
    <p class="footer-mark font-marca text-center text-[15.2vw] leading-[0.78] whitespace-nowrap text-crema/[0.09] select-none">Grupo Kasto</p>
  </div>
</footer>

<style>
  /* Pie: la granja al fondo y el nombre enorme en crema, que sube cuando el bloque entra en pantalla
     (el nombre queda tan abajo que no podría detectarse solo). */
  .footer-field {
    padding-top: 3vw;
  }
  /* Textos sobre el grabado: un halo del color del fondo los mantiene legibles */
  .footer-bottom,
  .farm ~ div ul,
  .farm ~ div address {
    text-shadow:
      0 0 8px var(--color-olivo),
      0 0 16px var(--color-olivo);
  }
  /* Granja: grande a la derecha en escritorio; centrada detrás del nombre en celular */
  .farm {
    right: -1%;
    bottom: 4.5vw;
    width: min(60rem, 54vw);
  }
  @media (max-width: 1023px) {
    .farm {
      right: 2vw;
      bottom: 9vw;
      width: 96vw;
    }
  }
  .farm-img {
    opacity: 0.15;
    /* Sin bordes de imagen: se disuelve hacia los lados y hacia arriba */
    -webkit-mask-image: radial-gradient(ellipse 72% 78% at 58% 60%, #000 50%, transparent 92%);
    mask-image: radial-gradient(ellipse 72% 78% at 58% 60%, #000 50%, transparent 92%);
  }
  @media (min-width: 1024px) {
    .farm-img {
      opacity: 0.17;
    }
  }
  /* Resplandor del sol del grabado, que respira lento */
  .farm-sun {
    position: absolute;
    left: 59.5%;
    top: 17%;
    width: 34%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(237 221 94 / 0.3), rgb(237 221 94 / 0.08) 45%, transparent 70%);
    animation: farm-sun 7s ease-in-out infinite;
  }
  @keyframes farm-sun {
    50% {
      transform: scale(1.18);
      opacity: 0.65;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .farm-sun {
      animation: none;
    }
  }
  .footer-mark {
    position: relative;
    margin-bottom: -0.1em;
    letter-spacing: 0.01em;
  }
  :global(html.js) .footer-mark {
    transform: translateY(40%);
    transition: transform 1.6s var(--ease-out-soft);
  }
  :global(html.js) .footer-mark {
    transition-delay: 0.15s;
  }
  .footer-field:global(.in-view) .footer-mark {
    transform: none;
  }
</style>

<script>
  const field = document.querySelector<HTMLElement>('[data-field]');
  if (field) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          field.classList.add('in-view');
          io.disconnect();
        }
      });
      io.observe(field);
    } else field.classList.add('in-view');
  }
</script>
