---
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';
import { site } from '../data/site';
import { divisions } from '../data/divisions';
import { services } from '../data/services';

const year = new Date().getFullYear();
const company = [
  { label: 'Historia', href: '/nosotros/' },
  { label: 'Filosofía', href: '/filosofia/' },
  { label: 'Certificaciones', href: '/certificaciones/' },
  { label: 'Sostenibilidad', href: '/sostenibilidad/' },
  { label: 'Galería', href: '/galeria/' },
  { label: 'Noticias', href: '/noticias/' },
  { label: 'Contacto', href: '/contacto/' },
];
---

<footer class="surcos-claro relative overflow-hidden bg-bosque text-harina">
  <!-- Balanza gigante de fondo -->
  <svg viewBox="0 0 118 64" class="pointer-events-none absolute -right-24 -bottom-16 w-[46rem] max-w-none text-white/[0.03]" fill="currentColor" aria-hidden="true">
    <path fill-rule="evenodd" d="M30 4 2 46h56L30 4Zm0 7.6L9.85 41.8h40.3L30 11.6Z"></path><path fill-rule="evenodd" d="M88 4 60 46h56L88 4Zm0 7.6L67.85 41.8h40.3L88 11.6Z"></path><path fill-rule="evenodd" d="M40 3h38L59 31 40 3Zm7.55 4L59 23.9 70.45 7h-22.9Z"></path><path d="M4 49.5h52c0 7-11.6 12-26 12S4 56.5 4 49.5Zm58 0h52c0 7-11.6 12-26 12s-26-5-26-12Z"></path>
  </svg>

  <div class="relative mx-auto max-w-[90rem] px-5 pt-20 pb-10 sm:px-8 lg:px-12 lg:pt-28">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="/" class="inline-flex h-11 text-trigo" aria-label="Grupo Kasto, inicio">
          <Logo class="h-full text-[1.25rem]" />
        </a>
        <p class="mt-7 max-w-sm font-serif text-2xl leading-snug font-light text-harina/90">
          Contribuimos al desarrollo integral de nuestras comunidades, llevando felicidad a la mesa de todos los hogares.
        </p>
        <div class="mt-8 flex gap-2">
          <SocialIcon network="linkedin" url={site.social.linkedin} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-bosque" />
          <SocialIcon network="facebook" url={site.social.facebook} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-bosque" />
          <SocialIcon network="instagram" url={site.social.instagram} class="border-white/15 hover:border-trigo hover:bg-trigo hover:text-bosque" />
        </div>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-8">
        <div>
          <p class="eyebrow text-brote">Divisiones</p>
          <ul class="mt-5 space-y-2.5 text-[0.92rem] text-harina/75">
            {
              divisions.map((d) => (
                <li>
                  <a href={`/divisiones/${d.slug}/`} class="link-line hover:text-white">
                    {d.short}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="eyebrow text-brote">Grupo Kasto</p>
          <ul class="mt-5 space-y-2.5 text-[0.92rem] text-harina/75">
            {
              company.map((c) => (
                <li>
                  <a href={c.href} class="link-line hover:text-white">
                    {c.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="eyebrow mt-9 text-brote">Servicios</p>
          <ul class="mt-5 space-y-2.5 text-[0.92rem] text-harina/75">
            {
              services.map((s) => (
                <li>
                  <a href={`/servicios/${s.slug}/`} class="link-line hover:text-white">
                    {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="eyebrow text-brote">Oficinas corporativas</p>
          <address class="mt-5 text-[0.92rem] leading-relaxed text-harina/75 not-italic">
            {site.address.street}<br />
            {site.address.city}, {site.address.stateShort}<br />
            C.P. {site.address.zip}
          </address>
          <ul class="mt-5 space-y-2.5 text-[0.92rem]">
            <li><a href={`mailto:${site.email}`} class="link-line text-harina hover:text-trigo">{site.email}</a></li>
            <li><a href={site.phoneHref} class="link-line text-harina hover:text-trigo">{site.phone}</a></li>
          </ul>
          <a href="/contacto/" class="btn btn-trigo mt-8 min-h-11 px-5 text-[0.7rem]">Escríbenos</a>
        </div>
      </div>
    </div>

    <div class="mt-20 flex flex-col gap-4 border-t border-white/10 pt-8 text-[0.8rem] text-harina/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Grupo Kasto. Todos los derechos reservados.</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href="/avisos-de-privacidad/" class="link-line hover:text-harina">Avisos de privacidad</a>
        <a href="/contacto/?tema=quejas" class="link-line hover:text-harina">Quejas y sugerencias</a>
        <a href="/sitemap-index.xml" class="link-line hover:text-harina">Mapa del sitio</a>
      </div>
    </div>
  </div>
</footer>
