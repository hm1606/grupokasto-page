---
// Logotipo de Grupo Kasto: la balanza + "Grupo Kasto" en versalitas, como el logotipo oficial.
// variant="stack" (oficial: balanza arriba, nombre abajo) · "full" (horizontal) · "mark" (solo la balanza)
import { MARK_SVG, MARK_VIEWBOX } from '../lib/brand';

type Props = { variant?: 'mark' | 'full' | 'stack'; class?: string; title?: string };
const { variant = 'stack', class: className = '', title = 'Grupo Kasto' } = Astro.props;
---

{
  variant === 'mark' ? (
    <svg viewBox={MARK_VIEWBOX} class={className} role="img" aria-label={title} set:html={MARK_SVG} />
  ) : variant === 'stack' ? (
    <span class:list={['inline-flex flex-col items-center', className]} role="img" aria-label={title}>
      <svg viewBox={MARK_VIEWBOX} class="h-[1.9em] w-auto" aria-hidden="true" set:html={MARK_SVG} />
      <span class="mt-[0.28em] font-[family-name:var(--font-marca)] text-[0.62em] leading-none tracking-[0.06em] whitespace-nowrap">Grupo Kasto</span>
    </span>
  ) : (
    <span class:list={['inline-flex items-center gap-[0.5em]', className]} role="img" aria-label={title}>
      <svg viewBox={MARK_VIEWBOX} class="h-[1.6em] w-auto shrink-0" aria-hidden="true" set:html={MARK_SVG} />
      <span class="font-[family-name:var(--font-marca)] text-[0.92em] leading-none tracking-[0.04em] whitespace-nowrap">Grupo Kasto</span>
    </span>
  )
}
