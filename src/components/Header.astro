---
import { getImage } from 'astro:assets';
import Logo from './Logo.astro';
import { img } from '../lib/images';
import { nav as navFor, site } from '../data/site';
import { divisions, divisionUrl } from '../data/divisions';
import { services, serviceUrl } from '../data/services';
import { routes, t, type Lang } from '../i18n/ui';

type Props = { lang: Lang; alternate: string; overHero?: boolean };
const { lang, alternate, overHero = true } = Astro.props;
const tx = t(lang);
// "Contacto" no va en la lista: el botón "Contáctanos" (y "Escríbenos" en celular) lleva al mismo lugar
const nav = navFor(lang).filter((n) => n.key !== 'contact');
const contact = routes.contact[lang];
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isActive = (href: string, children?: { href: string }[]) =>
  here === href || (href !== '/' && href !== '/en/' && here.startsWith(href)) || !!children?.some((c) => here === c.href);

// Submenús: Nosotros (del menú), Divisiones y Servicios (de sus datos, con foto de vista previa)
const preview = async (key: string) => (await getImage({ src: img(key), width: 560, format: 'webp', quality: 72 })).src;
type MenuItem = { label: string; href: string; note?: string; image?: string };
const menus: Record<string, MenuItem[]> = {
  about: nav.find((n) => n.key === 'about')?.children ?? [],
  divisions: await Promise.all(
    divisions.map(async (d) => ({ label: d.short[lang], href: divisionUrl(lang, d), note: d.region[lang], image: await preview(`divisiones/${d.id}/hero`) })),
  ),
  services: await Promise.all(
    services.map(async (s) => ({ label: s.name[lang], href: serviceUrl(lang, s), note: s.summary[lang], image: await preview(`servicios/${s.id}/hero`) })),
  ),
};
---

<header
  id="site-header"
  data-over={String(overHero)}
  class="group/h fixed inset-x-0 top-0 z-50 text-olivo transition-[transform,background-color,box-shadow,color] duration-500 ease-[cubic-bezier(.2,.7,.2,1)] data-[hidden=true]:-translate-y-full data-[over=true]:text-white data-[solid=true]:bg-crema/92 data-[solid=true]:text-olivo data-[solid=true]:shadow-[0_1px_0_rgba(64,74,61,.1)] data-[solid=true]:backdrop-blur-xl"
>
  <!-- Barra superior (como el sitio anterior): contacto y redes; se pliega al bajar -->
  <div class="topbar hidden overflow-hidden border-b border-current/12 transition-[height,opacity] duration-500 lg:block">
    <div class="mx-auto flex h-10 max-w-[90rem] items-center justify-between px-12 text-[0.8rem] font-medium opacity-85">
      <div class="flex items-center gap-7">
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:text-trigo">
          <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          {site.email}
        </a>
        <a href={site.phoneHref} class="inline-flex items-center gap-2 hover:text-trigo">
          <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg>
          {site.phone}
        </a>
      </div>
      <div class="flex items-center gap-6">
        <a href={`${contact}?tema=quejas`} class="hover:text-trigo">{tx.complaints}</a>
        <a href={site.social.linkedin} target="_blank" rel="noopener" class="hover:text-trigo">LinkedIn</a>
        <a href={site.social.facebook} target="_blank" rel="noopener" class="hover:text-trigo">Facebook</a>
        <a href={site.social.instagram} target="_blank" rel="noopener" class="hover:text-trigo">Instagram</a>
        <a href={alternate} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'} class="lang-switch inline-flex items-center gap-1.5 rounded border border-current/25 px-2 py-0.5 font-serif font-semibold tracking-[0.12em] hover:border-trigo hover:text-trigo" aria-label={tx.switchLangLabel}>
          {tx.switchLangShort}
        </a>
      </div>
    </div>
  </div>
  <div class="header-bar mx-auto flex h-[var(--header-now)] max-w-[90rem] items-center justify-between gap-6 px-5 sm:px-8 lg:px-12">
    <a href={routes.home[lang]} class="header-logo relative z-10 flex items-center" aria-label={`${site.name}, ${tx.home.toLowerCase()}`}>
      <Logo class="text-[1.2rem] lg:text-[1.6rem]" />
    </a>

    <nav aria-label={lang === 'es' ? 'Principal' : 'Main'} class="hidden h-full lg:block">
      <ul class="flex h-full items-center gap-1">
        {
          nav.map((item) => {
            const sub = menus[item.key];
            const active = isActive(item.href, item.children);
            return (
              <li class="has-menu relative flex h-full items-center">
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class="flex items-center gap-1.5 rounded-md px-3.5 py-2 font-serif text-[1.02rem] font-semibold tracking-[0.08em] uppercase transition-colors hover:bg-current/8 aria-[current=page]:text-hoja group-data-[over=true]/h:aria-[current=page]:text-trigo group-data-[solid=true]/h:aria-[current=page]:text-hoja"
                  aria-haspopup={sub ? 'true' : undefined}
                >
                  {item.label}
                  {sub && (
                    <svg viewBox="0 0 12 12" class="chev size-2.5 opacity-60 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                      <path d="m3 4.5 3 3 3-3" />
                    </svg>
                  )}
                </a>
                {sub && (
                  <div class="menu-panel invisible absolute top-[calc(100%-0.75rem)] left-1/2 w-max -translate-x-1/2 pt-3 opacity-0 transition-[opacity,visibility,translate] duration-300">
                    <div class:list={['menu-box grid rounded-2xl bg-crema p-3 text-olivo shadow-2xl ring-1 shadow-olivo/15 ring-olivo/8', sub[0]?.image && 'grid-cols-[1fr_15rem] gap-3']}>
                      <div class:list={['grid content-start gap-1', sub.length > 5 ? 'w-[36rem] grid-cols-2' : 'w-[22rem]']}>
                        {sub.map((s, i) => (
                          <a href={s.href} data-preview={s.image ? i : undefined} class="group flex items-start gap-4 rounded-2xl px-4 py-3.5 transition-colors hover:bg-gris/70 focus-visible:bg-gris/70">
                            <span class="mt-0.5 font-serif text-sm text-hoja tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                            <span class="flex flex-col gap-0.5">
                              <span class="flex items-center gap-2 text-[0.92rem] font-semibold">
                                {s.label}
                                <svg viewBox="0 0 16 16" class="arrow size-3 text-hoja opacity-0 transition-opacity group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                  <path d="M3 8h10m-4-4 4 4-4 4" />
                                </svg>
                              </span>
                              {s.note && <span class="line-clamp-1 text-[0.78rem] text-niebla">{s.note}</span>}
                            </span>
                          </a>
                        ))}
                        {item.key !== 'about' && (
                          <a
                            href={item.href}
                            class:list={['mt-1 flex items-center justify-between rounded-2xl bg-olivo px-5 py-3.5 text-[0.8rem] font-semibold text-crema transition-colors hover:bg-hoja', sub.length > 5 && 'col-span-2']}
                          >
                            {tx.seeAll} {item.label.toLowerCase()}
                            <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                              <path d="M3 8h10m-4-4 4 4-4 4" />
                            </svg>
                          </a>
                        )}
                      </div>
                      {sub[0]?.image && (
                        <div class="menu-preview relative overflow-hidden rounded-xl bg-olivo" aria-hidden="true">
                          {sub.map((s, i) => (
                            <img src={s.image} alt="" loading="lazy" decoding="async" data-k={i} class:list={['absolute inset-0 size-full object-cover', i === 0 && 'is-on']} />
                          ))}
                          <div class="absolute inset-0 bg-gradient-to-t from-olivo/70 to-transparent" />
                          <span class="menu-preview-label display absolute inset-x-4 bottom-3.5 text-2xl text-crema">{sub[0].label}</span>
                        </div>
                      )}
                    </div>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="relative z-10 flex items-center gap-2">
      <a href={alternate} hreflang={lang === 'es' ? 'en' : 'es'} class="lang-switch grid size-11 place-items-center rounded-full font-serif text-[0.95rem] font-semibold tracking-[0.1em] lg:hidden" aria-label={tx.switchLangLabel}>{tx.switchLangShort}</a>
      <a href={contact} aria-current={here.startsWith(contact) ? 'page' : undefined} class="btn btn-trigo hidden min-h-11 px-5 text-[0.9rem] ring-offset-2 ring-offset-transparent aria-[current=page]:ring-2 aria-[current=page]:ring-trigo/50 md:inline-flex">{tx.contactUs}</a>
      <button
        type="button"
        id="menu-toggle"
        class="grid size-11 place-items-center rounded-full lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={tx.openMenu}
        data-open-label={tx.openMenu}
        data-close-label={tx.closeMenu}
      >
        <span class="relative block h-3 w-6">
          <span class="menu-bar absolute inset-x-0 top-0 h-[1.5px] rounded bg-current transition-transform duration-500"></span>
          <span class="menu-bar absolute inset-x-0 bottom-0 h-[1.5px] rounded bg-current transition-transform duration-500"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Menú en celular -->
<div
  id="mobile-menu"
  class="surcos-claro invisible fixed inset-0 z-[45] flex flex-col overflow-y-auto bg-olivo px-6 pt-[calc(var(--header-h)+1.5rem)] pb-10 text-crema opacity-0 transition-[opacity,visibility] duration-500 data-[open=true]:visible data-[open=true]:opacity-100 lg:hidden"
  data-lenis-prevent
>
  <nav aria-label={tx.menu} class="flex-1">
    <ul class="flex flex-col">
      <li class="menu-item border-b border-white/10" style="--i:0">
        <a href={routes.home[lang]} class="display block py-4 text-4xl">{tx.home}</a>
      </li>
      {
        nav.map((item, i) => {
          const sub = menus[item.key];
          return (
            <li class="menu-item border-b border-white/10" style={`--i:${i + 1}`}>
              {sub ? (
                <details class="group/d">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-4">
                    <span class="display text-4xl">{item.label}</span>
                    <span class="grid size-9 place-items-center rounded-full border border-white/20 transition-transform duration-300 group-open/d:rotate-45">
                      <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path d="M8 3v10M3 8h10" />
                      </svg>
                    </span>
                  </summary>
                  <ul class="grid gap-1 pb-5">
                    {item.key !== 'about' && (
                      <li>
                        <a href={item.href} class="block py-1.5 text-base font-semibold text-trigo">
                          {tx.seeAllShort}
                        </a>
                      </li>
                    )}
                    {sub.map((s) => (
                      <li>
                        <a href={s.href} class="block py-1.5 text-base text-crema/80">
                          {s.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={item.href} class="display block py-4 text-4xl">
                  {item.label}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </nav>
  <div class="mt-8 flex flex-col gap-3">
    <a href={contact} class="btn btn-trigo">{tx.writeUs}</a>
    <a href={site.phoneHref} class="btn btn-outline-light">{tx.callUs} {site.phone}</a>
    <a href={alternate} hreflang={lang === 'es' ? 'en' : 'es'} class="btn btn-outline-light">{tx.switchLang}</a>
    <p class="eyebrow mt-3 text-center text-[0.6rem] text-brote">Grupo Kasto · {tx.since} {site.foundingYear}</p>
  </div>
</div>

<style>
  .has-menu:hover .menu-panel,
  .has-menu:focus-within .menu-panel {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
  }
  .menu-panel {
    translate: 0 8px;
  }
  /* Vista previa: la foto de la división/servicio bajo el mouse */
  .menu-preview img {
    opacity: 0;
    scale: 1.08;
    transition:
      opacity 0.5s var(--ease-out-soft),
      scale 1.2s var(--ease-out-soft);
  }
  .menu-preview img.is-on {
    opacity: 1;
    scale: 1;
  }
  .topbar {
    height: 2.5rem;
  }
  /* Escritorio: al bajar, el encabezado se compacta (no desaparece) */
  .header-bar {
    transition: height 0.5s var(--ease-out-soft);
  }
  .header-logo {
    transform-origin: left center;
    transition: transform 0.5s var(--ease-out-soft);
  }
  @media (min-width: 1024px) {
    #site-header[data-solid='true'] .header-logo {
      transform: scale(0.78);
    }
  }
  #site-header[data-solid='true'] .topbar {
    height: 0;
    opacity: 0;
    border-color: transparent;
  }
  .has-menu:hover .chev,
  .has-menu:focus-within .chev {
    transform: rotate(180deg);
  }
  #menu-toggle[aria-expanded='true'] .menu-bar:first-child {
    transform: translateY(5.25px) rotate(45deg);
  }
  #menu-toggle[aria-expanded='true'] .menu-bar:last-child {
    transform: translateY(-5.25px) rotate(-45deg);
  }
  html:has(#mobile-menu[data-open='true']) #site-header {
    color: var(--color-crema) !important;
    background: transparent !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
  }
  .menu-item {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.6s var(--ease-out-soft),
      transform 0.6s var(--ease-out-soft);
  }
  #mobile-menu[data-open='true'] .menu-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(100ms + var(--i) * 55ms);
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  // Fondo sólido al bajar. En celular se esconde al bajar y reaparece al subir.
  // Se cuenta el recorrido acumulado en una misma dirección: el scroll suave frena con pasos de 1-2 px al final de
  // cada movimiento, y reaccionar a esos pasos hacía que el menú se escondiera y volviera a aparecer (parpadeo).
  const desktop = window.matchMedia('(min-width: 1024px)');
  const HIDE_AFTER = 24; // px bajando seguidos para esconderlo
  const SHOW_AFTER = 12; // px subiendo seguidos para mostrarlo
  let last = window.scrollY;
  let run = 0;
  const set = (key: 'solid' | 'hidden', value: boolean) => {
    const v = String(value);
    if (header.dataset[key] !== v) header.dataset[key] = v;
  };
  const onScroll = () => {
    const y = window.scrollY;
    const d = y - last;
    last = y;
    set('solid', y > 24 || header.dataset.over === 'false');
    if (menu.dataset.open === 'true') return;
    // En escritorio el encabezado nunca se esconde: se compacta (CSS). En celular se esconde al bajar.
    if (y < 480 || desktop.matches) {
      run = 0;
      return set('hidden', false);
    }
    if (d === 0) return;
    run = Math.sign(d) === Math.sign(run) ? run + d : d;
    if (run > HIDE_AFTER) set('hidden', true);
    else if (run < -SHOW_AFTER) set('hidden', false);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    menu.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '');
    const lenis = (window as any).__lenis;
    open ? lenis?.stop() : lenis?.start();
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setMenu(menu.dataset.open !== 'true'));

  // Submenús con foto: al pasar por cada opción cambia la vista previa
  document.querySelectorAll<HTMLElement>('.menu-box').forEach((box) => {
    const imgs = box.querySelectorAll<HTMLImageElement>('.menu-preview img');
    const label = box.querySelector('.menu-preview-label');
    box.querySelectorAll<HTMLAnchorElement>('a[data-preview]').forEach((a) => {
      const show = () => {
        imgs.forEach((im) => im.classList.toggle('is-on', im.dataset.k === a.dataset.preview));
        if (label) label.textContent = a.querySelector('.font-semibold')?.textContent?.trim() ?? '';
      };
      a.addEventListener('mouseenter', show);
      a.addEventListener('focus', show);
    });
  });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && menu.dataset.open === 'true' && setMenu(false));
</script>
