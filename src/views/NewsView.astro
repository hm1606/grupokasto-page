---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Espiga from '../components/Espiga.astro';
import CtaBand from '../components/CtaBand.astro';
import NewsList from '../components/react/NewsList.tsx';
import { pic } from '../lib/images';
import { abs, breadcrumbs } from '../lib/seo';
import { categoryLabel, formatDate, getNews, newsUrl, readingTime } from '../lib/news';
import { routes, t, type Lang } from '../i18n/ui';

type Props = { lang: Lang };
const { lang } = Astro.props;
const tx = t(lang);
const L = (es: string, en: string) => (lang === 'es' ? es : en);
const path = routes.news[lang];
const crumbs = [
  { name: tx.home, path: routes.home[lang] },
  { name: L('Noticias', 'News'), path },
];
const all = await getNews(lang);
const [lead, ...side] = all.slice(0, 4);
const items = await Promise.all(
  all.map(async (n) => ({
    slug: n.slug,
    href: newsUrl(lang, n.slug),
    title: n.data.title,
    excerpt: n.data.excerpt,
    category: n.data.category,
    categoryLabel: categoryLabel(n.data.category, lang),
    date: n.data.date.toISOString().slice(0, 10),
    dateLabel: formatDate(n.data.date, lang, 'short'),
    year: n.data.date.getUTCFullYear(),
    minutes: readingTime(n.body),
    image: await pic(n.data.cover, [480, 800]),
  })),
);
const list = {
  '@type': 'ItemList',
  '@id': `${abs(path)}#noticias`,
  itemListElement: all.map((n, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(newsUrl(lang, n.slug)), name: n.data.title })),
};
---

<Layout
  lang={lang}
  alternate={routes.news[lang === 'es' ? 'en' : 'es']}
  title={L('Noticias', 'News')}
  description={L(
    'Noticias de Grupo Kasto: sostenibilidad, seguridad y bienestar laboral, eventos, nuestra gente y novedades de las divisiones.',
    'Grupo Kasto news: sustainability, workplace safety and well-being, events, our people and updates from our divisions.',
  )}
  pageType="CollectionPage"
  hasBreadcrumb
  headerOverHero={false}
  schema={[breadcrumbs(path, crumbs), list]}
>
  <!-- Portada editorial -->
  <section class="grano">
    <div class="mx-auto max-w-[90rem] px-5 pt-[calc(var(--header-h)+3rem)] pb-16 sm:px-8 lg:px-12 lg:pt-[calc(var(--header-h)+4rem)]">
      <Breadcrumbs crumbs={crumbs} />
      <div class="mt-8 flex flex-col gap-6 border-b border-olivo/15 pb-10 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow animate-fade-up text-hoja">{L('Sala de prensa', 'Newsroom')}</p>
          <h1 class="display animate-fade-up mt-2 text-7xl text-olivo uppercase sm:text-8xl lg:text-[9rem]" style="animation-delay:100ms">{L('Noticias', 'News')}</h1>
          <div class="animate-fade-up mt-3" style="animation-delay:180ms"><Espiga /></div>
        </div>
        <p class="animate-fade-up max-w-md text-lg leading-relaxed text-tinta/70" style="animation-delay:240ms">
          {L('Lo que pasa en Grupo Kasto: nuestra gente, nuestras divisiones y nuestro camino hacia la sostenibilidad.', 'What’s happening at Grupo Kasto: our people, our divisions and our road to sustainability.')}
        </p>
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-12">
        <a href={newsUrl(lang, lead.slug)} class="group lg:col-span-8" data-reveal>
          <div class="zoom relative aspect-[16/10] overflow-hidden rounded-[1.75rem] bg-gris">
            <Image src={lead.data.cover} alt="" widths={[640, 1000, 1400]} sizes="(min-width:1024px) 60vw, 100vw" class="size-full object-cover" loading="eager" />
            <span class="absolute top-5 left-5 rounded-md bg-trigo px-3 py-1.5 font-serif text-sm font-semibold tracking-[0.1em] text-olivo uppercase">{tx.latest}</span>
          </div>
          <p class="mt-6 flex flex-wrap items-center gap-3 text-sm text-niebla">
            <span class="font-serif font-semibold tracking-[0.1em] text-hoja uppercase">{categoryLabel(lead.data.category, lang)}</span>
            <span aria-hidden="true">·</span>
            <time datetime={lead.data.date.toISOString().slice(0, 10)}>{formatDate(lead.data.date, lang)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime(lead.body)} {tx.minRead}</span>
          </p>
          <h2 class="display mt-3 text-4xl text-balance text-olivo transition-colors group-hover:text-hoja sm:text-5xl lg:text-6xl">{lead.data.title}</h2>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-tinta/70">{lead.data.excerpt}</p>
        </a>
        <ol class="flex flex-col divide-y divide-olivo/12 lg:col-span-4">
          {
            side.map((n, i) => (
              <li class="py-6 first:pt-0" data-reveal style={`--reveal-delay:${(i + 1) * 90}ms`}>
                <a href={newsUrl(lang, n.slug)} class="group grid grid-cols-[1fr_7.5rem] gap-5">
                  <div>
                    <p class="font-serif text-sm font-semibold tracking-[0.1em] text-hoja uppercase">{categoryLabel(n.data.category, lang)}</p>
                    <h3 class="display mt-2 text-[1.55rem] leading-[1.08] text-olivo transition-colors group-hover:text-hoja">{n.data.title}</h3>
                    <time datetime={n.data.date.toISOString().slice(0, 10)} class="mt-2 block text-sm text-niebla">{formatDate(n.data.date, lang, 'short')}</time>
                  </div>
                  <div class="zoom aspect-square overflow-hidden rounded-xl bg-gris">
                    <Image src={n.data.cover} alt="" widths={[240, 480]} sizes="7.5rem" class="size-full object-cover" />
                  </div>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Archivo -->
  <section class="bg-crema">
    <div class="mx-auto max-w-[90rem] px-5 pt-10 pb-24 sm:px-8 lg:px-12 lg:pb-32">
      <p class="eyebrow text-hoja">{L('Archivo', 'Archive')}</p>
      <h2 class="display mt-2 text-5xl text-olivo">{L('Todas las noticias', 'All stories')}</h2>
      <div class="mt-8">
        <NewsList
          client:visible
          items={items}
          labels={{ all: tx.all, search: tx.searchNews, empty: tx.noNews, minRead: tx.minRead, archive: L('Categorías', 'Categories'), story: L('noticia', 'story'), stories: L('noticias', 'stories') }}
        />
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Layout>
