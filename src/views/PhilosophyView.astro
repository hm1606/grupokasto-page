---
// Filosofía: los textos en español son copia EXACTA del sitio anterior (src/data/company.ts → philosophy).
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Espiga from '../components/Espiga.astro';
import CtaBand from '../components/CtaBand.astro';
import { philosophy as ph } from '../data/company';
import { img } from '../lib/images';
import { breadcrumbs } from '../lib/seo';
import { routes, t, type Lang } from '../i18n/ui';

type Props = { lang: Lang };
const { lang } = Astro.props;
const tx = t(lang);
const L = (es: string, en: string) => (lang === 'es' ? es : en);
const path = routes.philosophy[lang];
const crumbs = [
  { name: tx.home, path: routes.home[lang] },
  { name: L('Nosotros', 'About us'), path: routes.about[lang] },
  { name: L('Filosofía', 'Philosophy'), path },
];
---

<Layout
  lang={lang}
  alternate={routes.philosophy[lang === 'es' ? 'en' : 'es']}
  title={L('Filosofía: propósito, misión, visión y valores', 'Philosophy: purpose, mission, vision and values')}
  description={L(
    'Propósito, misión, visión, valores y formas de trabajo de Grupo Kasto: compromiso, responsabilidad, honestidad, respeto a la persona, humildad y lealtad.',
    'Grupo Kasto’s purpose, mission, vision, values and ways of working: commitment, responsibility, honesty, respect for people, humility and loyalty.',
  )}
  pageType="AboutPage"
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs)]}
>
  <PageHero eyebrow={L('Filosofía', 'Philosophy')} title={ph.purposeEyebrow[lang]} image={img('portada/elote')} crumbs={crumbs} />

  <!-- Propósito -->
  <section class="grano">
    <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-36">
      <div class="lg:col-span-7">
        <p class="eyebrow text-azul" data-reveal>{ph.purposeEyebrow[lang]}</p>
        <h2 class="display mt-3 text-5xl text-marino sm:text-6xl" data-reveal style="--reveal-delay:60ms">{ph.purposeTitle[lang]}</h2>
        <div class="mt-5" data-reveal style="--reveal-delay:120ms"><Espiga /></div>
        <blockquote class="display relative mt-10 text-[2.2rem] leading-[1.1] text-balance text-marino sm:text-5xl lg:text-[3.6rem]" data-reveal style="--reveal-delay:180ms">
          <span class="absolute -top-10 -left-2 font-serif text-[7rem] leading-none text-celeste/70 select-none" aria-hidden="true">“</span>
          {ph.purpose[lang]}
        </blockquote>
      </div>
      <div class="relative lg:col-span-4 lg:col-start-9">
        <div class="overflow-hidden rounded-[2rem]" data-reveal="mask">
          <Image src={img('portada/silos-cielo')} alt={L('Silos bajo el cielo', 'Silos under the sky')} widths={[400, 700, 1000]} sizes="(min-width:1024px) 30vw, 100vw" class="aspect-[3/4] w-full object-cover" />
        </div>
        <span class="ph-badge absolute -bottom-8 -left-2 grid size-32 place-items-center rounded-full bg-white shadow-[0_30px_60px_-30px_rgb(14_44_88/.55)] ring-8 ring-nube sm:-left-6 sm:size-44 lg:-left-14" data-reveal style="--reveal-delay:500ms">
          <Image src={img(ph.icons.purpose)} format="png" alt={ph.purposeTitle[lang]} width={200} class="w-[62%] object-contain" />
        </span>
      </div>
    </div>
  </section>

  <!-- Misión y visión -->
  <section class="bg-perla/60">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead eyebrow={ph.missionEyebrow[lang]} title={ph.missionTitle[lang]} />
      <div class="mt-14 grid gap-5 lg:grid-cols-2">
        <article class="relative isolate overflow-hidden rounded-[2rem] bg-marino p-10 text-nube sm:p-14" data-reveal>
          <Image src={img('portada/silos')} alt="" widths={[640, 1000]} sizes="(min-width:1024px) 45vw, 100vw" class="absolute inset-0 -z-10 size-full object-cover opacity-20" />
          <span class="ph-tile grid size-24 place-items-center rounded-2xl bg-white sm:size-28"><Image src={img(ph.icons.mission)} format="png" alt="" width={160} class="w-[72%] object-contain" /></span>
          <p class="eyebrow mt-8 text-celeste">{L('Misión', 'Mission')}</p>
          <p class="display mt-6 text-3xl leading-snug sm:text-[2.6rem]">{ph.mission[lang]}</p>
        </article>
        <article class="relative isolate overflow-hidden rounded-[2rem] bg-celeste p-10 text-marino sm:p-14" data-reveal style="--reveal-delay:120ms">
          <svg viewBox="0 0 60 48" class="absolute -right-8 -bottom-10 -z-10 w-72 text-marino/10" aria-hidden="true"><use href="#gk-mark"></use></svg>
          <span class="ph-tile grid size-24 place-items-center rounded-2xl bg-white sm:size-28"><Image src={img(ph.icons.vision)} format="png" alt="" width={160} class="w-[72%] object-contain" /></span>
          <p class="eyebrow mt-8 text-marino">{L('Visión', 'Vision')}</p>
          <p class="display mt-6 text-3xl leading-snug sm:text-[2.6rem]">{ph.vision[lang]}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="grano">
    <div class="mx-auto grid max-w-[90rem] gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-32">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <SectionHead eyebrow={ph.valuesEyebrow[lang]} title={ph.valuesTitle[lang]} />
          <div class="mt-10 hidden overflow-hidden rounded-[2rem] lg:block" data-reveal="mask">
            <Image src={img('portada/espiga')} alt={L('Espigas de trigo', 'Wheat ears')} widths={[400, 800]} sizes="30vw" class="aspect-[4/5] w-full object-cover" />
          </div>
        </div>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
        {
          ph.values.map((v, i) => (
            <li class="value group relative overflow-hidden rounded-[1.5rem] bg-white p-8 ring-1 ring-marino/8 transition-[transform,box-shadow] duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-marino/8 sm:p-9" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
              <span class="absolute top-6 right-7 font-serif text-5xl font-semibold text-perla transition-colors duration-500 group-hover:text-celeste/60">{String(i + 1).padStart(2, '0')}</span>
              <Image src={img(v.icon)} format="png" alt="" width={176} class="ph-icon h-20 w-auto max-w-24 object-contain object-left sm:h-22" />
              <span class="mt-6 block h-1 w-10 rounded-full bg-azul transition-[width] duration-500 group-hover:w-16" aria-hidden="true" />
              <h3 class="display mt-4 text-3xl text-marino">{v.name[lang]}</h3>
              <p class="mt-3 leading-relaxed text-tinta/70">{v.text[lang]}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Formas de trabajo -->
  <section class="relative overflow-hidden bg-marino text-nube">
    <div class="absolute inset-0 opacity-25" data-parallax="0.1">
      <Image src={img('portada/molino-noche')} alt="" widths={[800, 1600]} sizes="100vw" class="h-[120%] w-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-marino via-marino/85 to-marino"></div>
    <div class="relative mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead light eyebrow={ph.waysEyebrow[lang]} title={ph.waysTitle[lang]} />
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          ph.ways.map((w, i) => (
            <article class="group relative rounded-[1.75rem] bg-white/6 p-8 ring-1 ring-white/10 backdrop-blur-sm transition-colors duration-500 hover:bg-white/10" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="absolute top-7 right-8 font-serif text-4xl font-semibold text-white/15 transition-colors duration-500 group-hover:text-celeste/60">{String(i + 1).padStart(2, '0')}</span>
              <span class="ph-tile grid size-24 place-items-center rounded-2xl bg-white"><Image src={img(w.icon)} format="png" alt="" width={160} class="w-[74%] object-contain" /></span>
              <h3 class="display mt-6 text-[1.8rem] leading-tight">{w.name[lang]}</h3>
              <p class="mt-3 leading-relaxed text-nube/70">{w.text[lang]}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <div class="pt-3 sm:pt-4"><CtaBand lang={lang} /></div>
</Layout>

<style>
  /* Íconos oficiales: crecen un poco al pasar el mouse (sin alterar el dibujo) */
  .ph-tile :global(img),
  .ph-icon,
  .ph-badge :global(img) {
    transition: transform 0.7s var(--ease-out-soft);
  }
  .group:hover .ph-tile :global(img),
  .group:hover .ph-icon,
  .ph-badge:hover :global(img),
  article:hover > .ph-tile :global(img) {
    transform: scale(1.08);
  }
</style>
