---
import Layout from '../layouts/Layout.astro';
import { divisions, divisionUrl } from '../data/divisions';
import { legacyMap, legacyRedirectScript } from '../lib/legacy';
import { routes, t, type Lang } from '../i18n/ui';

type Props = { lang: Lang };
const { lang } = Astro.props;
const tx = t(lang);
const map = await legacyMap();
---

<Layout lang={lang} title={lang === 'es' ? 'Página no encontrada' : 'Page not found'} noindex headerOverHero={false}>
  <!-- Si alguien llega con un enlace viejo de APEX (…/f?p=102:…), lo mandamos a la página nueva -->
  <script is:inline set:html={legacyRedirectScript(map)} />
  <section class="grano relative overflow-hidden">
    <svg viewBox="0 0 60 48" class="pointer-events-none absolute -right-20 bottom-0 w-[36rem] text-olivo/5" aria-hidden="true"><use href="#gk-mark"></use></svg>
    <div class="mx-auto flex min-h-[80svh] max-w-[90rem] flex-col justify-center px-5 pt-[calc(var(--header-h)+3rem)] pb-20 sm:px-8 lg:px-12">
      <p class="eyebrow text-hoja">Error 404</p>
      <h1 class="display mt-4 max-w-3xl text-6xl text-olivo uppercase sm:text-8xl">{tx.notFoundTitle}</h1>
      <p class="mt-6 max-w-xl text-lg text-tinta/70">{tx.notFoundText}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={routes.home[lang]} class="btn btn-primary">{tx.goHome}</a>
        <a href={routes.contact[lang]} class="btn btn-ghost">{tx.contactUs}</a>
      </div>
      <ul class="mt-14 flex flex-wrap gap-2">
        {
          divisions.map((d) => (
            <li>
              <a href={divisionUrl(lang, d)} class="inline-block rounded-lg bg-gris px-4 py-2 font-serif font-semibold tracking-[0.06em] text-olivo uppercase transition-colors hover:bg-hoja hover:text-white">
                {d.short[lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
