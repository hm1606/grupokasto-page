---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import ValueChain from '../components/ValueChain.astro';
import PresenceMap from '../components/PresenceMap.astro';
import ScrollText from '../components/react/ScrollText.tsx';
import HomeHero from '../components/react/HomeHero.tsx';
import CountUp from '../components/react/CountUp.tsx';
import DivisionsRail from '../components/react/DivisionsRail.tsx';
import WordBand from '../components/WordBand.astro';
import { experience, site, stats } from '../data/site';
import { divisionById, divisionUrl, divisions } from '../data/divisions';
import { brands, leaders, valueOffer } from '../data/company';
import { img, pic } from '../lib/images';
import { categoryLabel, formatDate, getNews, newsUrl } from '../lib/news';
import { routes, t, type Lang } from '../i18n/ui';

type Props = { lang: Lang };
const { lang } = Astro.props;
const tx = t(lang);
const L = (es: string, en: string) => (lang === 'es' ? es : en);
const alternate = routes.home[lang === 'es' ? 'en' : 'es'];

// Las mismas seis fotos del carrusel del sitio anterior
const heroSlides = await Promise.all(
  [
    { key: 'portada/elote', id: 'granos', alt: L('Mazorca en el campo', 'Corn in the field') },
    { key: 'divisiones/molinos-de-trigo/hero', id: 'molinos-de-trigo', alt: L('Silos de un molino de trigo', 'Wheat mill silos') },
    { key: 'divisiones/pecuaria/hero', id: 'pecuaria', alt: L('Cerdos en granja', 'Hogs on a farm') },
    { key: 'divisiones/invernaderos/hero', id: 'invernaderos', alt: L('Invernaderos reflejados en el agua', 'Greenhouses reflected in water') },
    { key: 'divisiones/panaderia-y-bistro/hero', id: 'panaderia-y-bistro', alt: L('Pan artesanal en Ohlala!', 'Artisan bread at Ohlala!') },
    { key: 'divisiones/productos-de-consumo/hero', id: 'productos-de-consumo', alt: L('Anaqueles de productos de consumo', 'Consumer goods on shelves') },
  ].map(async (s) => {
    const d = divisionById(s.id)!;
    return { label: d.short[lang], href: divisionUrl(lang, d), alt: s.alt, image: await pic(s.key, [800, 1400, 1920, 2400]) };
  }),
);
const wheat = (await getImage({ src: img('marca/trigo-silueta'), width: 1920, format: 'webp' })).src;

const divisionCards = await Promise.all(
  divisions.map(async (d) => ({
    slug: d.id,
    href: divisionUrl(lang, d),
    name: d.name[lang],
    short: d.short[lang],
    summary: d.summary[lang],
    region: d.region[lang],
    highlight: { value: d.highlights[0].value[lang], label: d.highlights[0].label[lang] },
    image: await pic(`divisiones/${d.id}/hero`, [640, 1000, 1400]),
  })),
);

const [lead, ...rest] = (await getNews(lang)).slice(0, 3);
const maxYears = Math.max(...experience.map((e) => e.years));
---

<Layout lang={lang} alternate={alternate} pageType="WebPage">
  <HomeHero
    client:load
    slides={heroSlides}
    wheat={wheat}
    copy={{
      eyebrow: L(`Contribuimos al desarrollo · Desde ${site.foundingYear}`, `Contributing to development · Since ${site.foundingYear}`),
      brand: site.name,
      words: L('Del campo a la mesa de México', 'From the field to Mexico’s table').split(' '),
      highlight: L('mesa', 'table'),
      text: L(
        'Granos, harinas, pecuaria, invernaderos, panadería y productos de consumo: ocho divisiones que trabajan juntas en el Bajío, Occidente y Noroeste del país.',
        'Grain, flour, livestock, greenhouses, bakery and consumer goods: eight divisions working together across central, western and northwestern Mexico.',
      ),
      primary: { label: L('Conoce las divisiones', 'Explore our divisions'), href: routes.divisions[lang] },
      secondary: { label: L('Nuestra historia', 'Our history'), href: routes.about[lang] },
      view: L('Ver', 'View'),
      next: L('Sigue', 'Up next'),
      scroll: L('Desliza', 'Scroll'),
    }}
  />

  <!-- Declaración: se ilumina palabra por palabra al hacer scroll -->
  <section class="grano">
    <div class="mx-auto max-w-6xl px-5 pt-24 pb-6 text-center sm:px-8 lg:pt-36">
      <p class="eyebrow text-hoja" data-reveal>{L('Acerca de nosotros', 'About us')}</p>
      <ScrollText
        client:visible
        text={L(
          'Somos un sólido y reconocido grupo de empresas agroindustriales con un gran compromiso social: producción, comercialización, servicios y distribución, del campo hasta tu hogar.',
          'We are a solid, well-established group of agribusiness companies with a strong social commitment: production, trading, services and distribution, from the field to your home.',
        )}
        highlight={lang === 'es' ? ['agroindustriales', 'compromiso', 'social:', 'hogar.'] : ['agribusiness', 'social', 'commitment:', 'home.']}
        className="display mt-6 text-[2.3rem] leading-[1.08] text-olivo sm:text-5xl lg:text-[4.1rem]"
      />
    </div>
  </section>

  <!-- Acerca de -->
  <section class="grano relative overflow-hidden">
    <div class="mx-auto grid max-w-[90rem] gap-16 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:gap-10 lg:px-12 lg:py-32">
      <div class="lg:col-span-6 lg:pr-10">
        <SectionHead
          eyebrow={L('Líderes en el mercado agrícola', 'Leaders in the agricultural market')}
          title={L('Del campo hasta <span class="text-hoja">su hogar</span>', 'From the field to <span class="text-hoja">your home</span>')}
        />
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-tinta/75" data-reveal style="--reveal-delay:200ms">
          <p>
            {
              L(
                'Nuestra gama de giros nos permite tener una estructura sólida para satisfacer exitosamente las demandas de suministro y calidad que requieren nuestros clientes, cumpliendo los retos de llevar a cabo prácticas cada vez más eficientes, innovadoras, inocuas y ecológicas.',
                'Our range of businesses gives us a solid structure to meet our customers’ supply and quality demands, rising to the challenge of increasingly efficient, innovative, safe and eco-friendly practices.',
              )
            }
          </p>
        </div>
        <div class="mt-10 grid gap-6 sm:grid-cols-2" data-reveal style="--reveal-delay:260ms">
          <div class="flex gap-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-hoja/12 text-hoja">
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 21V9m0 0c0-3 2-5 6-5 0 4-2 6-6 5Zm0 4c0-3-2-5-6-5 0 4 2 6 6 5Z"></path></svg>
            </span>
            <p>
              <strong class="block font-semibold text-olivo">{L('Ofrecemos los mejores productos', 'We offer the best products')}</strong>
              <span class="text-[0.95rem] text-tinta/65">{L('y servicios en nuestra zona de influencia.', 'and services in our region.')}</span>
            </p>
          </div>
          <div class="flex gap-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-trigo/35 text-hoja">
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 20h18M5 20V10l7-5 7 5v10M10 20v-5h4v5"></path></svg>
            </span>
            <p>
              <strong class="block font-semibold text-olivo">{L('Presencia regional', 'Regional presence')}</strong>
              <span class="text-[0.95rem] text-tinta/65">{L('en el Bajío, Occidente y Noroeste de México.', 'across central, western and northwestern Mexico.')}</span>
            </p>
          </div>
        </div>
        <a href={routes.about[lang]} class="btn btn-ghost group mt-12" data-reveal style="--reveal-delay:320ms">
          {L('Conoce nuestra historia', 'Read our story')}
          <svg viewBox="0 0 16 16" class="arrow size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4"></path></svg>
        </a>
      </div>
      <div class="relative lg:col-span-6">
        <div class="relative ml-auto w-[82%] overflow-hidden rounded-[2rem]" data-reveal="mask">
          <Image src={img('portada/silos')} alt={L('Silos de almacenamiento de granos', 'Grain storage silos')} widths={[480, 800, 1200]} sizes="(min-width:1024px) 40vw, 80vw" class="aspect-[4/5] w-full object-cover" />
        </div>
        <div class="absolute -bottom-10 left-0 w-[46%] overflow-hidden rounded-[1.5rem] border-8 border-crema shadow-xl shadow-olivo/10" data-reveal="mask" style="--reveal-delay:250ms" data-parallax="0.06">
          <Image src={img('portada/costal')} alt={L('Costal de harina con el logotipo de Grupo Kasto', 'Flour sack with the Grupo Kasto logo')} widths={[320, 640]} sizes="(min-width:1024px) 20vw, 45vw" class="aspect-[4/5] w-full object-cover" />
        </div>
        <div class="absolute top-8 -left-2 rounded-2xl bg-olivo px-6 py-5 text-crema shadow-xl sm:left-6 lg:-left-6" data-reveal style="--reveal-delay:400ms">
          <p class="display text-5xl text-trigo">1945</p>
          <p class="mt-1 text-sm text-crema/70">La Piedad, Michoacán</p>
        </div>
      </div>
    </div>

    <!-- Cifras -->
    <div class="mx-auto max-w-[90rem] px-5 pb-24 sm:px-8 lg:px-12 lg:pb-32">
      <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-[2rem] bg-olivo/10 lg:grid-cols-4">
        {
          stats.map((s, i) => (
            <div class="bg-crema p-7 sm:p-10" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <dt class="sr-only">{s.label[lang]}</dt>
              <dd>
                <CountUp client:visible to={s.value} suffix={s.suffix} className="display block text-5xl text-olivo sm:text-6xl lg:text-7xl" />
                <p class="mt-3 font-semibold text-olivo">{s.label[lang]}</p>
                <p class="mt-1 text-sm text-niebla">{s.note[lang]}</p>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Divisiones: recorrido horizontal -->
  <DivisionsRail
    client:idle
    items={divisionCards}
    copy={{
      eyebrow: L('Nuestras divisiones', 'Our divisions'),
      title: L("Ocho divisiones, <span class='text-trigo'>una sola</span> cadena de valor", "Eight divisions, <span class='text-trigo'>one</span> value chain"),
      text: valueOffer.intro[lang],
      cta: tx.viewDivision,
      all: L('Ver todas', 'See all'),
      allHref: routes.divisions[lang],
      hint: L('Sigue bajando para recorrerlas', 'Keep scrolling to explore'),
      swipe: L('Desliza para ver las ocho', 'Swipe to see all eight'),
    }}
  />

  <WordBand
    words={L('Granos,Harinas,Pecuaria,Invernaderos', 'Grain,Flour,Livestock,Greenhouses').split(',')}
    alt={L('Panadería,Consumo,Logística,Desde 1945', 'Bakery,Consumer goods,Logistics,Since 1945').split(',')}
  />

  <ValueChain lang={lang} />

  <PresenceMap lang={lang} />

  <!-- Experiencia -->
  <section class="relative overflow-hidden bg-gris/70">
    <div class="relative mx-auto grid max-w-[90rem] gap-16 px-5 py-24 sm:px-8 lg:grid-cols-2 lg:gap-24 lg:px-12 lg:py-32">
      <div>
        <SectionHead
          eyebrow={L('Con casi un siglo en el negocio', 'Almost a century in business')}
          title={L('Nuestra experiencia', 'Our experience')}
          text={L(
            'Los orígenes de Grupo Kasto se remontan al año de 1945, cuando el fundador se integra al negocio de la venta de granos en un establecimiento conocido como “La Maicería”, en La Piedad Michoacán.',
            'Grupo Kasto’s origins go back to 1945, when its founder joined the grain business at a store known as “La Maicería” in La Piedad, Michoacán.',
          )}
        />
        <div class="relative mt-12 overflow-hidden rounded-[2rem]" data-reveal="mask">
          <Image src={img('portada/costales-antiguos')} alt={L('Costales antiguos de grano', 'Old grain sacks')} widths={[480, 800]} sizes="(min-width:1024px) 40vw, 100vw" class="aspect-[16/10] w-full object-cover" />
        </div>
      </div>
      <div class="lg:pt-6">
        <p class="eyebrow text-hoja" data-reveal>{L('Años en cada giro', 'Years in each business')}</p>
        <ul class="mt-8 space-y-7">
          {
            experience.map((e, i) => (
              <li data-reveal style={`--reveal-delay:${i * 70}ms`} class="exp">
                <div class="flex items-baseline justify-between gap-4">
                  <span class="text-lg font-semibold text-olivo">{e.label[lang]}</span>
                  <span class="display text-4xl text-hoja tabular-nums">
                    {e.years}
                    <span class="ml-1 font-sans text-sm text-niebla">{tx.years}</span>
                  </span>
                </div>
                <div class="mt-3 h-1 overflow-hidden rounded-full bg-olivo/10">
                  <span class="exp-bar block h-full rounded-full bg-gradient-to-r from-hoja to-trigo" style={`--w:${(e.years / maxYears) * 100}%`} />
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Frase: la foto se acerca y el texto se ilumina palabra por palabra al bajar -->
  <section class="relative isolate flex min-h-[100svh] items-center overflow-hidden bg-sombra text-white">
    <div class="absolute inset-0 -z-10" data-parallax="0.18">
      <Image src={img('portada/bodega')} alt="" widths={[800, 1400, 2000, 2400]} sizes="100vw" class="h-[130%] w-full object-cover" />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-sombra/85 via-sombra/55 to-sombra/85"></div>
    <div class="mx-auto max-w-[90rem] px-5 py-32 text-center sm:px-8 lg:px-12">
      <p class="eyebrow flex items-center justify-center gap-3 text-trigo" data-reveal>
        <span class="h-px w-8 bg-trigo/60" aria-hidden="true"></span>Grupo Kasto<span class="h-px w-8 bg-trigo/60" aria-hidden="true"></span>
      </p>
      <ScrollText
        client:visible
        text={L('La agricultura es importante para el desarrollo futuro', 'Agriculture matters for our future')}
        highlight={lang === 'es' ? ['desarrollo', 'futuro'] : ['our', 'future']}
        highlightClass="text-trigo"
        dim={0.14}
        className="display mx-auto mt-8 max-w-6xl text-[3.4rem] leading-[0.95] uppercase sm:text-8xl lg:text-[8.5rem]"
      />
    </div>
  </section>

  <!-- Oferta de valor -->
  <section class="grano">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead align="center" eyebrow={L('Con un enfoque centrado en el cliente', 'Customer-centered')} title={L('Nuestra oferta de valor', 'Our value proposition')} text={valueOffer.body[lang]} />
      <div class="mx-auto mt-14 flex max-w-3xl flex-col items-center gap-2 text-center" data-reveal>
        <CountUp client:visible to={3300} className="display text-7xl text-hoja sm:text-8xl" />
        <p class="eyebrow text-olivo">{L('Clientes satisfechos', 'Satisfied customers')}</p>
      </div>
      <div class="mt-14 grid gap-5 lg:grid-cols-3">
        {
          leaders.map((l, i) => (
            <figure class="flex flex-col justify-between rounded-[2rem] bg-white/70 p-8 ring-1 ring-olivo/8 sm:p-10" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <svg viewBox="0 0 32 24" class="h-6 w-8 text-trigo" fill="currentColor" aria-hidden="true">
                <path d="M0 24V14C0 6 4 1 12 0l1 4c-4 1-6 4-6 8h5v12H0Zm19 0V14c0-8 4-13 12-14l1 4c-4 1-6 4-6 8h5v12H19Z" />
              </svg>
              <blockquote class="mt-6 text-lg leading-relaxed text-olivo">{l.quote[lang]}</blockquote>
              <figcaption class="mt-8 flex items-center gap-4 border-t border-olivo/10 pt-6">
                <Image src={img(`personas/${l.image}`)} alt="" widths={[96, 192]} sizes="48px" class="size-12 rounded-full object-cover" />
                <span>
                  <span class="block font-semibold text-olivo">{l.name}</span>
                  <span class="text-sm text-niebla">{l.role[lang]}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sostenibilidad -->
  <section class="bg-gris/60">
    <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-2 lg:gap-24 lg:px-12 lg:py-32">
      <div class="relative order-2 lg:order-1">
        <div class="overflow-hidden rounded-[2rem]" data-reveal="mask">
          <Image src={img('portada/contacto')} alt={L('Campo de cultivo en flor con sistema de riego', 'Flowering crop field with irrigation')} widths={[640, 1000, 1400]} sizes="(min-width:1024px) 45vw, 100vw" class="aspect-[5/4] w-full object-cover" />
        </div>
        <div class="absolute -right-3 -bottom-8 grid grid-cols-3 gap-2 rounded-2xl bg-white p-3 shadow-xl shadow-olivo/10 sm:right-8" data-reveal style="--reveal-delay:250ms">
          <span class="rounded-xl bg-hoja px-4 py-3 text-center font-serif text-sm font-semibold tracking-[0.06em] text-white uppercase">{L('Ambiental', 'Environmental')}</span>
          <span class="rounded-xl bg-trigo px-4 py-3 text-center font-serif text-sm font-semibold tracking-[0.06em] text-olivo uppercase">Social</span>
          <span class="rounded-xl bg-olivo px-4 py-3 text-center font-serif text-sm font-semibold tracking-[0.06em] text-crema uppercase">{L('Gobernanza', 'Governance')}</span>
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <SectionHead
          eyebrow={L('Rumbo a la sostenibilidad', 'On the road to sustainability')}
          title={L("Un modelo para crecer <span class='text-hoja'>cuidando</span> el entorno", "A model to grow while <span class='text-hoja'>caring</span> for our world")}
          text={L(
            'Desde 2024 integramos los criterios ASG —Ambiental, Social y Gobernanza— a la operación diaria, alineados con los Objetivos de Desarrollo Sostenible de la ONU.',
            'Since 2024 we have brought ESG —Environmental, Social and Governance— criteria into daily operations, aligned with the UN Sustainable Development Goals.',
          )}
        />
        <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--reveal-delay:220ms">
          <a href={routes.sustainability[lang]} class="btn btn-primary group">
            {L('Conoce el modelo', 'Explore the model')}
            <svg viewBox="0 0 16 16" class="arrow size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4"></path></svg>
          </a>
          <a href={routes.certifications[lang]} class="btn btn-ghost">{L('Certificaciones', 'Certifications')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Noticias: nota principal y dos más -->
  <section class="grano">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
        <SectionHead eyebrow={L('Desde Grupo Kasto', 'From Grupo Kasto')} title={L('Noticias recientes', 'Latest news')} />
        <a href={routes.news[lang]} class="btn btn-ghost group shrink-0" data-reveal>
          {tx.allNews}
          <svg viewBox="0 0 16 16" class="arrow size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4"></path></svg>
        </a>
      </div>
      <div class="mt-14 grid gap-6 lg:grid-cols-12">
        <a href={newsUrl(lang, lead.slug)} class="group relative isolate flex min-h-[28rem] flex-col justify-end overflow-hidden rounded-[2rem] bg-olivo p-8 text-white sm:p-10 lg:col-span-7 lg:min-h-[36rem]" data-reveal>
          <div class="zoom absolute inset-0 -z-10">
            <Image src={lead.data.cover} alt="" widths={[640, 1000, 1400]} sizes="(min-width:1024px) 55vw, 100vw" class="size-full object-cover" />
          </div>
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-olivo via-olivo/50 to-transparent"></div>
          <p class="flex items-center gap-3 text-sm">
            <span class="rounded-md bg-trigo px-2.5 py-1 font-serif font-semibold tracking-[0.08em] text-olivo uppercase">{categoryLabel(lead.data.category, lang)}</span>
            <time datetime={lead.data.date.toISOString().slice(0, 10)} class="text-white/80">{formatDate(lead.data.date, lang)}</time>
          </p>
          <h3 class="display mt-4 max-w-2xl text-4xl sm:text-5xl">{lead.data.title}</h3>
          <p class="mt-3 line-clamp-2 max-w-xl text-white/80">{lead.data.excerpt}</p>
        </a>
        <div class="grid gap-6 lg:col-span-5">
          {
            rest.map((n, i) => (
              <a href={newsUrl(lang, n.slug)} class="group grid grid-cols-[9rem_1fr] items-center gap-5 rounded-[1.5rem] bg-white/70 p-4 ring-1 ring-olivo/8 sm:grid-cols-[12rem_1fr]" data-reveal style={`--reveal-delay:${(i + 1) * 100}ms`}>
                <div class="zoom aspect-square overflow-hidden rounded-xl bg-gris">
                  <Image src={n.data.cover} alt="" widths={[320, 480]} sizes="12rem" class="size-full object-cover" />
                </div>
                <div>
                  <p class="font-serif text-sm font-semibold tracking-[0.08em] text-hoja uppercase">{categoryLabel(n.data.category, lang)}</p>
                  <h3 class="display mt-2 text-2xl leading-tight text-olivo transition-colors group-hover:text-hoja">{n.data.title}</h3>
                  <time datetime={n.data.date.toISOString().slice(0, 10)} class="mt-2 block text-sm text-niebla">{formatDate(n.data.date, lang)}</time>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Marcas -->
  <section class="overflow-hidden border-y border-olivo/8 bg-white/60 py-14" aria-label={L('Empresas y marcas de Grupo Kasto', 'Grupo Kasto companies and brands')}>
    <p class="eyebrow text-center text-niebla">{L('Empresas y marcas del grupo', 'Our companies and brands')}</p>
    <div class="marquee mt-10 flex w-max animate-marquee items-center gap-16 hover:[animation-play-state:paused]">
      {
        [...brands, ...brands].map((b, i) => (
          <Image
            src={img(`marcas/${b.image}`)}
            alt={i < brands.length ? b.name : ''}
            aria-hidden={i >= brands.length ? 'true' : undefined}
            widths={[160, 320]}
            sizes="160px"
            class="h-14 w-auto max-w-40 object-contain opacity-70 grayscale transition duration-500 hover:opacity-100 hover:grayscale-0"
          />
        ))
      }
    </div>
  </section>

  <div class="pt-3 sm:pt-4"><CtaBand lang={lang} /></div>
</Layout>

<style>
  .exp-bar {
    width: 0;
    transition: width 1.6s var(--ease-out-soft) 0.2s;
