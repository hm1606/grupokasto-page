---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Gallery from '../components/react/Gallery.tsx';
import DirectoryFinder from '../components/react/DirectoryFinder.tsx';
import { divisions, divisionUrl, type Division } from '../data/divisions';
import { services, serviceUrl } from '../data/services';
import { img, pic } from '../lib/images';
import { breadcrumbs, division as divisionSchema } from '../lib/seo';
import { routes, t, type Lang } from '../i18n/ui';

type Props = { lang: Lang; d: Division };
const { lang, d } = Astro.props;
const tx = t(lang);
const L = (es: string, en: string) => (lang === 'es' ? es : en);
const other: Lang = lang === 'es' ? 'en' : 'es';
const path = divisionUrl(lang, d);
const crumbs = [
  { name: tx.home, path: routes.home[lang] },
  { name: L('Divisiones', 'Divisions'), path: routes.divisions[lang] },
  { name: d.short[lang], path },
];
const idx = divisions.findIndex((x) => x.id === d.id);
const prev = divisions[(idx - 1 + divisions.length) % divisions.length];
const next = divisions[(idx + 1) % divisions.length];
const related = services.filter((s) => s.division === d.id);

const galleryItems = await Promise.all(
  d.gallery.map(async (g) => ({
    thumb: await pic(`divisiones/${d.id}/${g.image}`, [480, 800, 1200]),
    full: await pic(`divisiones/${d.id}/${g.image}`, [1200, 1800, 2400]),
    caption: g.caption[lang],
    note: d.short[lang],
  })),
);
const sections = [
  { id: 'division', label: L('La división', 'The division') },
  { id: 'unidades', label: L('Unidades de negocio', 'Business units') },
  { id: 'directorio', label: L('Directorio', 'Directory') },
  { id: 'instalaciones', label: L('Instalaciones', 'Facilities') },
];
---

<Layout
  lang={lang}
  alternate={divisionUrl(other, d)}
  title={d.seo.title[lang]}
  description={d.seo.description[lang]}
  image={`/og/${lang === 'en' ? 'en/' : ''}divisiones/${d.id}.jpg`}
  imageAlt={d.name[lang]}
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs), divisionSchema(d, lang)]}
>
  <PageHero eyebrow={d.name[lang]} title={d.headline[lang]} intro={d.summary[lang]} image={img(`divisiones/${d.id}/hero`)} crumbs={crumbs}>
    <dl class="animate-fade-up mt-12 grid max-w-3xl grid-cols-3 gap-6 border-t border-white/15 pt-6" style="animation-delay:360ms" data-intro-wait>
      {
        d.highlights.map((h) => (
          <div>
            <dt class="sr-only">{h.label[lang]}</dt>
            <dd>
              <span class="display block text-2xl text-trigo sm:text-4xl">{h.value[lang]}</span>
              <span class="mt-1 block text-xs text-white/75 sm:text-sm">{h.label[lang]}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </PageHero>

  <!-- Navegación dentro de la división -->
  <nav aria-label={d.short[lang]} class="subnav sticky top-0 z-30 border-b border-olivo/10 bg-crema/90 backdrop-blur-xl">
    <div class="mx-auto flex max-w-[90rem] items-center gap-1 overflow-x-auto px-5 [scrollbar-width:none] sm:px-8 lg:px-12">
      {
        sections.map((s) => (
          <a href={`#${s.id}`} class="shrink-0 px-4 py-4 font-serif text-[0.95rem] font-semibold tracking-[0.08em] text-olivo/60 uppercase transition-colors hover:text-hoja">
            {s.label}
          </a>
        ))
      }
      <a href={routes.contact[lang]} class="btn btn-primary my-2 ml-auto hidden min-h-10 shrink-0 px-4 text-[0.85rem] md:inline-flex">{tx.contactUs}</a>
    </div>
  </nav>

  <!-- Qué hace -->
  <section id="division" class="grano">
    <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-32">
      <div class="lg:col-span-6">
        <SectionHead eyebrow={L('La división', 'The division')} title={d.name[lang]} />
        <div class="prose-gk mt-8" data-reveal style="--reveal-delay:200ms">
          {d.intro.map((p) => <p>{p[lang]}</p>)}
        </div>
        <p class="mt-10 flex items-center gap-2 font-serif text-[0.95rem] font-semibold tracking-[0.1em] text-niebla uppercase" data-reveal style="--reveal-delay:260ms">
          <svg viewBox="0 0 24 24" class="size-4 text-hoja" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
          {d.region[lang]}
        </p>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <div class="overflow-hidden rounded-[2rem]" data-reveal="mask">
          <Image src={img(`divisiones/${d.id}/info`)} alt={d.name[lang]} widths={[480, 800, 1200]} sizes="(min-width:1024px) 38vw, 100vw" class="aspect-[4/5] w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Unidades de negocio -->
  <section id="unidades" class="relative overflow-hidden bg-olivo text-crema">
    <div class="surcos-claro absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-[90rem] gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-32">
      <div class="lg:col-span-5">
        <SectionHead light eyebrow={L('¿Quiénes participan en la división?', 'Who is part of the division?')} title={L('Unidades de negocio', 'Business units')} />
        <p class="mt-8 text-lg leading-relaxed text-crema/75" data-reveal style="--reveal-delay:200ms">{d.unitsNote[lang]}</p>
      </div>
      <ol class="lg:col-span-6 lg:col-start-7">
        {
          d.units.map((u, i) => (
            <li class="flex items-baseline gap-6 border-b border-white/10 py-6 first:border-t" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="font-serif text-lg font-semibold text-trigo tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <span class="display text-2xl sm:text-3xl">{u[lang]}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Directorio -->
  <section id="directorio" class="bg-gris/60">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead eyebrow={L('Directorio', 'Directory')} title={L('Dónde encontrarnos', 'Where to find us')} />
      <div class="mt-14" data-reveal>
        <DirectoryFinder
          client:visible
          places={d.directory.map((e) => ({
            title: e.company,
            subtitle: e.place?.[lang],
            lines: e.lines,
            phones: e.phones,
            web: e.web,
            social: e.social,
            query: `${e.company.replace(/, S\.A\. de C\.V\.$/, '')} ${e.place?.es ?? ''}, ${e.lines.join(', ')}, México`,
          }))}
          labels={{ directions: L('Cómo llegar', 'Get directions'), website: L('Sitio web', 'Website'), mapOf: L('Mapa de', 'Map of'), call: L('Llamar al', 'Call') }}
        />
      </div>
    </div>
  </section>

  <!-- Instalaciones -->
  <section id="instalaciones" class="grano">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <SectionHead eyebrow={L('Nuestras instalaciones', 'Our facilities')} title={L('Conócelas', 'Take a look')} />
      <div class="mt-12" data-reveal>
        <Gallery client:visible lang={lang} items={galleryItems} />
      </div>
      {
        related.length > 0 && (
          <div class="mt-20">
            <p class="eyebrow text-niebla">{tx.relatedService}</p>
            <div class="mt-5 grid gap-4 md:grid-cols-2">
              {related.map((s) => (
                <a href={serviceUrl(lang, s)} class="group flex items-center justify-between gap-6 rounded-[1.75rem] bg-white p-8 ring-1 ring-olivo/8 transition-shadow hover:shadow-xl hover:shadow-olivo/8">
                  <span>
                    <span class="display block text-3xl text-olivo">{s.name[lang]}</span>
                    <span class="mt-2 block text-tinta/65">{s.summary[lang]}</span>
                  </span>
                  <span class="grid size-12 shrink-0 place-items-center rounded-full bg-olivo text-crema transition-colors group-hover:bg-hoja">
                    <svg viewBox="0 0 16 16" class="arrow size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M3 8h10m-4-4 4 4-4 4" />
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- Otras divisiones -->
  <nav aria-label={L('Otras divisiones', 'Other divisions')} class="border-t border-olivo/10 bg-crema">
    <div class="mx-auto grid max-w-[90rem] sm:grid-cols-2">
      <a href={divisionUrl(lang, prev)} class="group relative isolate flex min-h-44 flex-col justify-end gap-2 overflow-hidden px-5 py-10 text-white sm:px-8 lg:px-12">
        <Image src={img(`divisiones/${prev.id}/hero`)} alt="" widths={[640, 1000]} sizes="50vw" class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-1000 group-hover:scale-105" />
        <span class="absolute inset-0 -z-10 bg-olivo/75 transition-colors duration-500 group-hover:bg-olivo/60"></span>
        <span class="eyebrow text-trigo">{tx.prevDivision}</span>
        <span class="display text-4xl">{prev.short[lang]}</span>
      </a>
      <a href={divisionUrl(lang, next)} class="group relative isolate flex min-h-44 flex-col items-end justify-end gap-2 overflow-hidden px-5 py-10 text-right text-white sm:px-8 lg:px-12">
        <Image src={img(`divisiones/${next.id}/hero`)} alt="" widths={[640, 1000]} sizes="50vw" class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-1000 group-hover:scale-105" />
        <span class="absolute inset-0 -z-10 bg-olivo/75 transition-colors duration-500 group-hover:bg-olivo/60"></span>
        <span class="eyebrow text-trigo">{tx.nextDivision}</span>
        <span class="display text-4xl">{next.short[lang]}</span>
      </a>
    </div>
  </nav>

  <CtaBand lang={lang} title={L(`¿Te interesa <span class="text-trigo">${d.short.es.toLowerCase()}</span>?`, `Interested in <span class="text-trigo">${d.short.en.toLowerCase()}</span>?`)} />
</Layout>

<style is:global>
  /* La barra de secciones baja cuando el encabezado está visible */
  .subnav {
    transition: top 0.5s var(--ease-out-soft);
  }
  html:has(#site-header:not([data-hidden='true'])[data-solid='true']) .subnav {
    top: var(--header-h);
  }
</style>
