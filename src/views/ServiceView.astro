---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, serviceUrl, type Service } from '../data/services';
import { divisionById, divisionUrl } from '../data/divisions';
import { telHref } from '../data/site';
import { img } from '../lib/images';
import { breadcrumbs, service as serviceSchema } from '../lib/seo';
import { routes, t, type Lang } from '../i18n/ui';

type Props = { lang: Lang; s: Service };
const { lang, s } = Astro.props;
const tx = t(lang);
const L = (es: string, en: string) => (lang === 'es' ? es : en);
const other: Lang = lang === 'es' ? 'en' : 'es';
const path = serviceUrl(lang, s);
const crumbs = [
  { name: tx.home, path: routes.home[lang] },
  { name: L('Servicios', 'Services'), path: routes.services[lang] },
  { name: s.name[lang], path },
];
const division = divisionById(s.division);
---

<Layout
  lang={lang}
  alternate={serviceUrl(other, s)}
  title={s.seo.title[lang]}
  description={s.seo.description[lang]}
  image={`/og/${lang === 'en' ? 'en/' : ''}servicios/${s.id}.jpg`}
  imageAlt={`${s.headline[lang]} · Grupo Kasto`}
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs), serviceSchema(s, lang)]}
>
  <PageHero eyebrow={L('Servicios', 'Services')} title={s.headline[lang]} intro={s.summary[lang]} image={img(`servicios/${s.id}/hero`)} crumbs={crumbs} />

  <section class="grano">
    <div class="mx-auto grid max-w-[90rem] gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:px-12 lg:py-32">
      <!-- Menú de servicios -->
      <aside class="lg:col-span-4">
        <div class="space-y-5 lg:sticky lg:top-32">
          <nav aria-label={L('Servicios', 'Services')} class="rounded-[1.75rem] bg-white p-3 ring-1 ring-olivo/8">
            <ul>
              {
                services.map((x) => (
                  <li>
                    <a
                      href={serviceUrl(lang, x)}
                      aria-current={x.id === s.id ? 'page' : undefined}
                      class="group flex items-center justify-between rounded-2xl px-5 py-4 font-semibold text-olivo/70 transition-colors hover:bg-gris/60 hover:text-olivo aria-[current=page]:bg-olivo aria-[current=page]:text-crema"
                    >
                      {x.name[lang]}
                      <svg viewBox="0 0 16 16" class="arrow size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="M3 8h10m-4-4 4 4-4 4" />
                      </svg>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="rounded-[1.75rem] bg-hoja p-8 text-white">
            <p class="eyebrow text-white/80">{tx.needHelp}</p>
            <p class="mt-4 leading-relaxed text-white/90">{tx.needHelpText}</p>
            <a href={telHref(s.phone)} class="display mt-5 block text-3xl hover:text-trigo">{s.phone}</a>
            <a href={routes.contact[lang]} class="btn btn-trigo mt-6 min-h-11 w-full text-[0.9rem]">{tx.writeUs}</a>
          </div>
        </div>
      </aside>

      <div class="lg:col-span-7 lg:col-start-6">
        <h2 class="display text-4xl text-balance text-olivo sm:text-5xl" data-reveal>{s.headline[lang]}</h2>
        <div class="prose-gk mt-8" data-reveal style="--reveal-delay:120ms">
          {s.body.map((p) => <p>{p[lang]}</p>)}
        </div>
        <ul class="mt-10 grid gap-3 sm:grid-cols-2" data-reveal style="--reveal-delay:180ms">
          {
            s.points.map((p) => (
              <li class="flex items-start gap-3 rounded-xl bg-gris/70 p-5">
                <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-hoja text-white">
                  <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                    <path d="m5 12 5 5 9-10" />
                  </svg>
                </span>
                <span class="font-medium text-olivo">{p[lang]}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-12 grid grid-cols-2 gap-4">
          <div class="overflow-hidden rounded-[1.75rem]" data-reveal="mask">
            <Image src={img(`servicios/${s.id}/a`)} alt="" widths={[400, 800]} sizes="(min-width:1024px) 28vw, 45vw" class="aspect-[4/5] w-full object-cover" />
          </div>
          <div class="mt-12 overflow-hidden rounded-[1.75rem]" data-reveal="mask" style="--reveal-delay:180ms">
            <Image src={img(`servicios/${s.id}/b`)} alt="" widths={[400, 800]} sizes="(min-width:1024px) 28vw, 45vw" class="aspect-[4/5] w-full object-cover" />
          </div>
        </div>
        {
          division && (
            <a href={divisionUrl(lang, division)} class="group mt-12 flex items-center justify-between gap-6 border-t border-olivo/10 pt-8" data-reveal>
              <span>
                <span class="eyebrow block text-niebla">{tx.backedBy}</span>
                <span class="display mt-2 block text-3xl text-olivo transition-colors group-hover:text-hoja">{division.name[lang]}</span>
              </span>
              <svg viewBox="0 0 16 16" class="arrow size-5 text-hoja" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M3 8h10m-4-4 4 4-4 4" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Layout>
