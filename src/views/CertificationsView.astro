---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { certifications, certificationsIntro, greenhouseCertifications, greenhouseIntro } from '../data/company';
import { img } from '../lib/images';
import { breadcrumbs } from '../lib/seo';
import { routes, t, type Lang } from '../i18n/ui';

type Props = { lang: Lang };
const { lang } = Astro.props;
const tx = t(lang);
const L = (es: string, en: string) => (lang === 'es' ? es : en);
const path = routes.certifications[lang];
const crumbs = [
  { name: tx.home, path: routes.home[lang] },
  { name: L('Nosotros', 'About us'), path: routes.about[lang] },
  { name: L('Certificaciones', 'Certifications'), path },
];
---

<Layout
  lang={lang}
  alternate={routes.certifications[lang === 'es' ? 'en' : 'es']}
  title={L('Certificaciones de calidad e inocuidad', 'Quality and food-safety certifications')}
  description={L(
    'ISO 9001:2015 y HACCP en granos y molinos desde 2012; FSSC 22000 y Kosher en Molino La Concepción desde 2022; distintivo ESR y certificados de exportación en invernaderos.',
    'ISO 9001:2015 and HACCP in grain and flour mills since 2012; FSSC 22000 and Kosher at Molino La Concepción since 2022; ESR distinction and export certifications in greenhouses.',
  )}
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs)]}
>
  <PageHero
    eyebrow={L('Certificaciones', 'Certifications')}
    title={L('Comprometidos con la calidad', 'Committed to quality')}
    intro={certificationsIntro[0][lang]}
    image={img('portada/certificaciones')}
    crumbs={crumbs}
  />

  <section class="grano">
    <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SectionHead eyebrow={L('Comprometidos con la calidad', 'Committed to quality')} title={L('Nuestros Certificados', 'Our Certifications')} />
          <div class="prose-gk mt-8" data-reveal style="--reveal-delay:160ms">
            {certificationsIntro.slice(1).map((p) => <p>{p[lang]}</p>)}
          </div>
          <div class="mt-10 overflow-hidden rounded-[2rem]" data-reveal="mask">
            <Image src={img('portada/molino-trigo')} alt={L('Molino de trigo', 'Wheat mill')} widths={[480, 900]} sizes="(min-width:1024px) 38vw, 100vw" class="aspect-[4/3] w-full object-cover" />
          </div>
        </div>
        <ul class="grid content-start gap-5 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
          {
            certifications.map((c, i) => (
              <li class="group flex flex-col rounded-[1.75rem] bg-white p-8 ring-1 ring-olivo/8 transition-[transform,box-shadow] duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-olivo/8" data-reveal style={`--reveal-delay:${i * 90}ms`}>
                <div class="grid h-32 place-items-center rounded-2xl bg-crema">
                  <Image src={img(`certificaciones/${c.image}`)} alt={`${L('Logotipo', 'Logo')} ${c.name}`} widths={[160, 320]} sizes="140px" class="max-h-24 w-auto object-contain transition-transform duration-500 group-hover:scale-105" />
                </div>
                <h3 class="display mt-7 text-3xl text-olivo">{c.name}</h3>
                <p class="mt-2 leading-relaxed text-tinta/70">{c.text[lang]}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-olivo text-crema">
    <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-2 lg:gap-24 lg:px-12 lg:py-32">
      <div>
        <SectionHead light eyebrow={L('De la mano de nuestra comunidad', 'Hand in hand with our community')} title={L('Empresa socialmente Responsable', 'Socially Responsible Company')} text={greenhouseIntro[lang]} />
        <ul class="mt-10 divide-y divide-white/10 border-y border-white/10">
          {
            greenhouseCertifications.map((c, i) => (
              <li class="flex items-center gap-5 py-4" data-reveal style={`--reveal-delay:${i * 60}ms`}>
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-trigo text-olivo">
                  <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg>
                </span>
                <span class="text-lg">{c[lang]}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="overflow-hidden rounded-[2rem]" data-reveal="mask">
        <Image src={img('portada/invernadero-madera')} alt={L('Productos de invernadero', 'Greenhouse produce')} widths={[640, 1000, 1400]} sizes="(min-width:1024px) 45vw, 100vw" class="aspect-[4/5] w-full object-cover" />
      </div>
    </div>
  </section>

  <div class="pt-3 sm:pt-4"><CtaBand lang={lang} /></div>
</Layout>
