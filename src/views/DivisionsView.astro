---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import ValueChain from '../components/ValueChain.astro';
import { divisions, divisionUrl } from '../data/divisions';
import { img } from '../lib/images';
import { abs, breadcrumbs } from '../lib/seo';
import { routes, t, type Lang } from '../i18n/ui';

type Props = { lang: Lang };
const { lang } = Astro.props;
const tx = t(lang);
const L = (es: string, en: string) => (lang === 'es' ? es : en);
const path = routes.divisions[lang];
const crumbs = [
  { name: tx.home, path: routes.home[lang] },
  { name: L('Divisiones', 'Divisions'), path },
];
const list = {
  '@type': 'ItemList',
  '@id': `${abs(path)}#divisiones`,
  itemListElement: divisions.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.name[lang], url: abs(divisionUrl(lang, d)) })),
};
const wide = (i: number) => i === 0 || i === divisions.length - 1;
---

<Layout
  lang={lang}
  alternate={routes.divisions[lang === 'es' ? 'en' : 'es']}
  title={L('Divisiones de negocio', 'Business divisions')}
  description={L(
    'Granos, molinos de trigo, pecuaria, servicios, invernaderos, panadería y bistró, productos de consumo y promotora de inversión: las ocho divisiones de Grupo Kasto.',
    'Grain, wheat flour mills, livestock, services, greenhouses, bakery and bistro, consumer goods and investment promotion: Grupo Kasto’s eight divisions.',
  )}
  pageType="CollectionPage"
  hasBreadcrumb
  schema={[breadcrumbs(path, crumbs), list]}
>
  <PageHero
    eyebrow={L('Divisiones', 'Divisions')}
    title={L('Ocho divisiones, una misma cadena de valor', 'Eight divisions, one value chain')}
    intro={L('Desde el acopio del grano hasta el anaquel y la mesa: así se complementan los negocios de Grupo Kasto.', 'From grain storage to the shelf and the table: this is how Grupo Kasto’s businesses complement each other.')}
    image={img('portada/trigal')}
    crumbs={crumbs}
  />

  <section class="grano">
    <div class="mx-auto max-w-[90rem] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
      <ul class="grid gap-5 md:grid-cols-2">
        {
          divisions.map((d, i) => (
            <li class:list={[wide(i) && 'md:col-span-2']} data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
              <a href={divisionUrl(lang, d)} class="group relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-[2rem] bg-olivo p-8 text-white sm:p-10 lg:min-h-[32rem]">
                <div class="zoom absolute inset-0 -z-10">
                  <Image src={img(`divisiones/${d.id}/hero`)} alt="" widths={[640, 1000, 1600]} sizes={wide(i) ? '(min-width:768px) 90vw, 100vw' : '(min-width:768px) 45vw, 100vw'} class="size-full object-cover" />
                </div>
                <div class="absolute inset-0 -z-10 bg-gradient-to-t from-olivo via-olivo/40 to-transparent" />
                <div class="flex items-end justify-between gap-8">
                  <div>
                    <p class="eyebrow text-trigo">
                      {String(i + 1).padStart(2, '0')} · {d.region[lang]}
                    </p>
                    <h2 class="display mt-3 text-5xl uppercase sm:text-6xl">{d.short[lang]}</h2>
                    <p class="mt-3 max-w-xl text-white/85">{d.summary[lang]}</p>
                    <dl class="mt-6 hidden gap-8 border-t border-white/20 pt-5 sm:flex">
                      {d.highlights.slice(0, 2).map((h) => (
                        <div>
                          <dt class="sr-only">{h.label[lang]}</dt>
                          <dd>
                            <span class="display block text-3xl text-trigo">{h.value[lang]}</span>
                            <span class="text-sm text-white/70">{h.label[lang]}</span>
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                  <span class="grid size-14 shrink-0 place-items-center rounded-full bg-white/15 backdrop-blur transition-colors duration-500 group-hover:bg-trigo group-hover:text-olivo">
                    <svg viewBox="0 0 16 16" class="arrow size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M3 8h10m-4-4 4 4-4 4" />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ValueChain lang={lang} />

  <div class="pt-3 sm:pt-4"><CtaBand lang={lang} /></div>
</Layout>
