# Copiar a .env en el servidor (/var/www/grupokasto-page/.env). No se sube a git.
# Sin RESEND_API_KEY el formulario usa FormSubmit (la primera vez manda un correo de activación a CONTACT_TO_EMAIL).
RESEND_API_KEY=
CONTACT_TO_EMAIL=comunicacion@grupokasto.com
CONTACT_BCC_EMAIL=
CONTACT_FROM_EMAIL=grupokasto.com <web@grupokasto.com>
